    { "action": "wait", "label": "The tank builds a threat lead", "ms": 3000 },
    { "action": "attack", "label": "The bystander joins her threat list", "actor": "bystander", "target": "jandice" },
    { "action": "wait", "ms": 1500 },
    { "action": "stop_attack", "actor": "bystander" },
