    { "action": "wait", "ms": 1500 },
    { "action": "set_health", "actor": "tank", "value": 100000000, "maximum": 100000000 },
    { "action": "set_health", "actor": "bystander", "value": 100000000, "maximum": 100000000 },
    { "action": "summon", "actor": "tank", "as": "jandice", "entry": 10503, "distance": 4 },
    { "action": "encounter_start", "actor": "tank", "boss_entry": 10503, "radius": 30 },
    { "action": "attack", "actor": "tank", "target": "jandice" },
    { "action": "assert", "label": "CONTROL: Jandice is in combat", "actor": "jandice", "metric": "combat",
