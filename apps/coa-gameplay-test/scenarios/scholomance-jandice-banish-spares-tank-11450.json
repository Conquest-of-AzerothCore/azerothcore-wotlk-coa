  "timeout_ms": 120000,
  "location": { "map": 0, "x": -8914.0, "y": -133.0, "z": 80.6, "o": 0.0 },
  "players": [
    { "id": "tank", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000 },
    { "id": "bystander", "race": 1, "class": 1, "level": 60 }
  ],
  "steps": [
