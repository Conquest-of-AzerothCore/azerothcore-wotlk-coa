          "item_guid": 975001
        },
        {
          "u32": 0
        },
        {
          "u32": 0
        },
        {
          "u64": 0
        },
        {
          "u8": 0
        }
      ]
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: daily reward tokens cannot be mailed to another account",
      "actor": "hero",
      "metric": "server_packet_u32",
      "opcode": 569,
      "index": 2,
      "equals": 1
    },
    {
      "action": "assert",
