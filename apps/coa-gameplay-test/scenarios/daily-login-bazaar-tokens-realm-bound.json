      "label": "The Daily Login Reward arrives by mail",
      "actor": "hero",
      "metric": "mail_has_item",
      "item": 975001,
      "equals": 1,
      "within_ms": 15000
    },
    {
      "action": "client_packet",
      "label": "Take the reward tokens from the mailbox",
      "actor": "hero",
      "opcode": 582,
      "consumed": false,
      "fields": [
        {
          "gameobject_guid": 142119
        },
        {
          "mail_id": 975001
        },
        {
          "mail_item_guid": 975001
        }
      ]
    },
    {
      "action": "assert",
