{
  "schema": 1,
  "name": "Daily Login Reward Bazaar Tokens are Realm Bound: they cannot be mailed to another account",
  "contract": [
    "The 200 Bazaar Tokens (975001) the Daily Login Reward mails (coa_daily_login_rewards) join the account's",
    "Realm Bound reserve, like the Elite Warchest's tokens: once taken from the mail they cannot be mailed to another",
    "account, so throwaway accounts cannot collect the reward and pass it on. Mail to the account's own characters",
    "stays free (the shared reserve path elite-warchest-bazaar-tokens-realm-bound covers; a second character of the",
    "same account is left out here because the account's single claim would go to whichever character logs in first)."
  ],
  "timeout_ms": 60000,
  "location": {
    "map": 0,
    "x": -9465,
    "y": 64,
    "z": 56,
    "o": 0
  },
  "players": [
    {
      "id": "hero",
      "name": "Coadailyhero",
      "race": 1,
      "class": 1,
      "level": 10
    },
    {
      "id": "other",
      "name": "Coadailyoth",
      "race": 1,
      "class": 1,
      "level": 1
    }
  ],
  "steps": [
