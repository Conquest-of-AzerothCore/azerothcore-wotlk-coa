      "actor": "lead",
      "map": 309,
      "x": -12326.5,
      "y": -1577.11,
      "z": 133.588,
      "o": 4.817,
      "ignore_access": true
    },
    {
      "action": "wait",
      "label": "Let the leader's transfer finish",
      "ms": 2000
    },
    {
      "action": "teleport",
      "actor": "mate",
      "map": 309,
      "x": -12326.5,
      "y": -1577.11,
      "z": 133.588,
      "o": 4.817,
      "ignore_access": true
    },
    {
      "action": "wait",
      "label": "Let the mate's transfer finish",
      "ms": 2000
    },
    {
      "action": "assert",
      "label": "CONTROL: the leader is in Zul'Gurub on Mythic",
      "actor": "lead",
      "metric": "map_difficulty",
      "equals": 2
    },
    {
      "action": "assert",
      "label": "CONTROL: the mate is in the same Mythic Zul'Gurub",
      "actor": "mate",
      "metric": "map_difficulty",
      "equals": 2
    },
    {
      "action": "summon",
      "actor": "lead",
      "entry": 15082,
      "as": "grilek",
      "distance": 4
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "attack",
      "actor": "lead",
      "target": "grilek"
    },
    {
      "action": "attack",
      "actor": "mate",
      "target": "grilek"
    },
    {
      "action": "assert",
      "label": "CONTROL: Gri'lek fights",
      "actor": "grilek",
      "metric": "combat",
      "equals": 1,
      "within_ms": 10000
    },
    {
      "action": "stop_attack",
      "actor": "lead"
    },
    {
      "action": "stop_attack",
      "actor": "mate"
    },
    {
      "action": "assert",
      "label": "CONTROL: the first rising-speed stack comes 1 s into the fight",
      "actor": "grilek",
      "metric": "aura_stacks",
      "spell": 1002357,
      "equals": 1,
      "within_ms": 5000
