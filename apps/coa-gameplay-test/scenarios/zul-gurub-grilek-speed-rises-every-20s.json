      "actor": "lead",
      "value": 10000000,
      "maximum": 10000000
    },
    {
      "action": "set_health",
      "actor": "mate",
      "value": 10000000,
      "maximum": 10000000
    },
    {
      "action": "raid_difficulty_packet",
      "actor": "lead",
      "value": 2
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
