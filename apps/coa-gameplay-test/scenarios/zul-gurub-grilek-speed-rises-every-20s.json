      "actor": "grilek",
      "metric": "run_speed_rate",
      "ratio_to": "one_stack_speed",
      "min": 1.09,
      "max": 1.1
    },
    {
      "action": "assert",
      "label": "CONTROL: Avatar still slows him",
      "actor": "grilek",
      "metric": "aura",
      "spell": 83068,
      "equals": 1
