    { "action": "add_item", "label": "Fixture: one Bear Tooth short of the carry limit", "actor": "hero",
      "item": 560338, "count": 49 },
    { "action": "assert", "label": "The hero carries 49 Bear Teeth", "actor": "hero", "metric": "item_count",
      "item": 560338, "equals": 49 },

    { "action": "learn", "actor": "hero", "spell": 9930889 },
    { "action": "cast", "actor": "hero", "spell": 9930889 },
    { "action": "assert", "label": "Lootbot 3000 is out", "actor": "hero", "metric": "pet_entry", "equals": 44022,
