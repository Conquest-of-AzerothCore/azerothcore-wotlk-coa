    { "action": "summon", "actor": "hero", "entry": 164039, "as": "bear", "distance": 4 },
    { "action": "wait", "ms": 300 },
    { "action": "attack_nearby", "label": "Kill the Scadeald Bear", "actor": "hero", "entry": 164039, "kill": true },
    { "action": "assert", "actor": "bear", "metric": "alive", "equals": 0, "within_ms": 2000 },
    { "action": "assert", "label": "DISCRIMINATING: the Lootbot takes the tooth that fits", "actor": "hero",
