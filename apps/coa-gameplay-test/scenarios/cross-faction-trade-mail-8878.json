{
  "schema": 1,
  "name": "AllowTwoSide.Trade and AllowTwoSide.Interaction.Mail open trade and mail across factions (#8878)",
  "contract": "With both options enabled, an ordinary Alliance player's CMSG_INITIATE_TRADE on a Horde player beside them reaches the Horde player as TRADE_STATUS_BEGIN_TRADE (1), and CMSG_SEND_MAIL with an attached item to that Horde player returns MAIL_OK (0), charges the 30 copper postage and delivers the item.",
  "two_side": {
    "trade": true,
    "mail": true
  },
  "players": [
    {
      "id": "alliance",
      "name": "Coatradea",
      "race": 1,
      "class": 1,
      "level": 20
    },
    {
      "id": "horde",
      "name": "Coatradeh",
      "race": 2,
      "class": 1,
      "level": 20
    }
  ],
  "location": {
    "map": 0,
    "x": -9465,
    "y": 64,
    "z": 56,
    "o": 0
  },
  "steps": [
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "snapshot",
      "actor": "alliance",
      "metric": "server_packets",
      "opcode": 288,
      "save_as": "alliance_trade"
    },
    {
      "action": "snapshot",
      "actor": "horde",
      "metric": "server_packets",
      "opcode": 288,
      "save_as": "horde_trade"
    },
    {
      "action": "client_packet",
      "actor": "alliance",
      "opcode": 278,
      "consumed": false,
      "fields": [
        {
          "actor_guid": "horde"
        }
      ]
    },
    {
      "action": "assert",
      "actor": "horde",
      "metric": "server_packets",
      "opcode": 288,
      "relative_to": "horde_trade",
      "min": 1,
      "within_ms": 1000
    },
    {
      "action": "assert",
      "actor": "horde",
      "metric": "server_packet_u32",
      "opcode": 288,
      "index": 0,
      "equals": 1,
      "label": "The Horde player receives the Alliance trade request"
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "server_packets",
      "opcode": 288,
      "relative_to": "alliance_trade",
      "equals": 0,
      "label": "The initiator is not refused"
    },
    {
      "action": "summon_gameobject",
      "actor": "alliance",
      "entry": 142119
    },
    {
      "action": "money",
      "actor": "alliance",
      "copper": 30
    },
    {
      "action": "add_item",
      "actor": "alliance",
      "item": 2447
    },
    {
      "action": "client_packet",
      "actor": "alliance",
      "opcode": 568,
      "consumed": false,
      "fields": [
        {
          "gameobject_guid": 142119
        },
        {
          "string": "Coatradeh"
        },
        {
          "string": "CoA cross-faction mail regression"
        },
        {
          "string": "Native mail request"
        },
        {
          "u32": 41
        },
        {
          "u32": 0
        },
        {
          "u8": 1
        },
        {
          "u8": 0
        },
        {
          "item_guid": 2447
        },
        {
          "u32": 0
        },
        {
          "u32": 0
        },
        {
          "u64": 0
        },
        {
          "u8": 0
        }
      ]
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "server_packet_u32",
      "opcode": 569,
      "index": 2,
      "equals": 0,
      "label": "Alliance mails a Horde player"
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "item_count",
      "item": 2447,
      "equals": 0
    },
    {
      "action": "assert",
      "actor": "alliance",
      "metric": "carried_money",
      "equals": 0
    },
    {
      "action": "relog",
      "actor": "horde"
    },
    {
      "action": "assert",
      "actor": "horde",
      "metric": "mail_has_item",
      "item": 2447,
      "equals": 1,
      "within_ms": 1000,
      "label": "The Horde player receives the mailed item"
    }
  ]
}
