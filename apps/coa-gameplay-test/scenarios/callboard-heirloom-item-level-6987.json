{
  "schema": 1,
  "name": "The Callboard gives heirlooms no item level, like the character sheet (#6987)",
  "contract": "The Callboard's highest reached item level (criterion 80129, saved in core.callboard.itemlevel) and its generic cache tier use the same equipped average item level the character sheet shows: seventeen slots without shirt and tabard, an heirloom counted as item level 0 and every other item at its template item level. A level 44 character wearing six heirlooms over its item level 1 starter pants and boots therefore averages (6 x 0 + 2) / 17 = 0.12 and reaches item level 0, not the 41 that counting each heirloom as 2.33 times the level gave. A value an earlier build saved higher than the equipped average is lowered once at the next login; a reached value saved after that correction is a high-water mark and survives later logins.",
  "timeout_ms": 120000,
  "location": {
    "map": 0,
    "x": -8828.19,
    "y": 627.502,
    "z": 94.0287
  },
  "players": [
