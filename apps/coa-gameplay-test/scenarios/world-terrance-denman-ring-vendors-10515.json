{
  "schema": 1,
  "name": "Terrance Denman sells the base-tier level-60 rings in Stormwind and Orgrimmar",
  "contract": [
    "Terrance Denman <Ring Vendor> 1532172 (Stormwind) and 1532173 (Orgrimmar) had no template, so nobody sold the",
    "Ascension rings. Each shop opens with the six base rings (Exiles DB vendor page) at their 600 gold item price.",
    "The Inscribed, Etched and Runed upgrades unlock with later raid releases, so they are not on the shelves yet;",
    "a vendor_price of -1 means the item is not sold."
  ],
  "timeout_ms": 60000,
  "location": {
    "map": 0,
    "x": -8855.885,
    "y": 853.7891,
    "z": 99.60983,
    "o": 1.1356559
  },
