    {
      "action": "assert",
      "label": "Cleric's Circle 1540585 for 600 gold",
      "actor": "p",
      "metric": "vendor_price",
      "item": 1540585,
      "equals": 6000000
    },
    {
      "action": "assert",
      "label": "Warrior's Band 1544935 for 600 gold",
      "actor": "p",
      "metric": "vendor_price",
      "item": 1544935,
      "equals": 6000000
