{
  "schema": 1,
  "name": "CoA world map patch: the Alterac map 4418 area and its 15 overlays reach the client at login",
  "contract": [
    "Requires CoA.SendDisplayPatches=1.",
    "The client has no WorldMapArea row 3044 or WorldMapOverlay rows 2964-2978; Pitho's WorldMapArea.dbc and WorldMapOverlay.dbc add them.",
    "The login patch stream sends coa_client_world_map_area as SMSG_PATCH_WORLD_MAP_AREA (0x09AA) and coa_client_world_map_overlay as SMSG_PATCH_WORLD_MAP_OVERLAY (0x09AC).",
    "Each record carries the DBC words in file order with 0 in the string slot, followed by the name as a length-prefixed string.",
    "The float words equal the raw bits of Pitho's WorldMapArea.dbc row 3044.",
    "Socketless packet construction does not establish how the client renders the map."
  ],
  "timeout_ms": 60000,
  "location": {
    "map": 0,
    "x": -9465,
    "y": 64,
    "z": 56,
    "o": 0
  },
  "players": [
    {
      "id": "client",
      "race": 1,
      "class": 1,
      "level": 10
    }
  ],
  "steps": [
    {
      "action": "wait",
      "ms": 6000
    },
    {
      "action": "assert",
      "label": "The login stream sends WorldMapArea row 3044 once",
      "actor": "client",
      "metric": "server_packets",
      "opcode": 2474,
      "row": 3044,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "Row 3044 belongs to map 4418",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2474,
      "row": 3044,
      "index": 1,
      "equals": 4418
    },
    {
      "action": "assert",
      "label": "Row 3044 covers area 36",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2474,
      "row": 3044,
      "index": 2,
      "equals": 36
    },
    {
      "action": "assert",
      "label": "Row 3044 leaves the AreaName slot empty",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2474,
      "row": 3044,
      "index": 3,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "Row 3044 LocLeft carries the DBC bits of 783",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2474,
      "row": 3044,
      "index": 4,
      "equals": 1145290752
    },
    {
      "action": "assert",
      "label": "Row 3044 LocBottom carries the DBC bits of -366",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2474,
      "row": 3044,
      "index": 7,
      "equals": 3283550208
    },
    {
      "action": "assert",
      "label": "Row 3044 has no virtual map",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2474,
      "row": 3044,
      "index": 8,
      "equals": 4294967295
    },
    {
      "action": "assert",
      "label": "Row 3044 names its texture folder Alterac",
      "actor": "client",
      "metric": "server_packet_contains",
      "opcode": 2474,
      "row": 3044,
      "text": "Alterac",
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The login stream sends the 15 Alterac overlays",
      "actor": "client",
      "metric": "server_packets",
      "opcode": 2476,
      "equals": 15
    },
    {
      "action": "assert",
      "label": "Overlay 2964 belongs to WorldMapArea 3044",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2476,
      "row": 2964,
      "index": 1,
      "equals": 3044
    },
    {
      "action": "assert",
      "label": "Overlay 2964 leaves the TextureName slot empty",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2476,
      "row": 2964,
      "index": 8,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "Overlay 2964 ends with HitRectRight 915",
      "actor": "client",
      "metric": "server_packet_u32",
      "opcode": 2476,
      "row": 2964,
      "index": 16,
      "equals": 915
    },
    {
      "action": "assert",
      "label": "Overlay 2964 names its texture CHILLWINDPOINT",
      "actor": "client",
      "metric": "server_packet_contains",
      "opcode": 2476,
      "row": 2964,
      "text": "CHILLWINDPOINT",
      "equals": 1
    }
  ]
}
