      "actor": "hero",
      "metric": "whisper_contains",
      "text": "COAQLOG\tQ 5\t",
      "equals": 1,
      "within_ms": 2000
    },
    {
      "action": "quest_abandon",
      "label": "The client's abandon packet names overflow slot 25",
      "actor": "hero",
      "quest": 5,
      "slot": 25
    },
    {
      "action": "assert",
      "label": "The client packet cannot remove an overflow quest, so Jitters' Growling Gut stays complete",
      "actor": "hero",
      "metric": "quest_status",
      "quest": 5,
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "addon_message",
      "label": "Abandon from the window",
      "actor": "hero",
      "prefix": "COAQLOG",
      "text": "ABANDON 5"
    },
    {
      "action": "assert",
      "label": "The window abandons the overflow quest",
      "actor": "hero",
      "metric": "quest_status",
      "quest": 5,
      "equals": 0,
      "within_ms": 2000
    },
    {
      "action": "assert",
      "label": "The window learns the overflow log is empty",
      "actor": "hero",
      "metric": "whisper_contains",
      "text": "COAQLOG\tEMPTY",
      "equals": 1,
