      "actor": "caster",
      "metric": "aura",
      "spell": 320832,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 303041 loads the record's 5% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 303041,
      "equals": 5
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312832 loads the record's 5% chance",
