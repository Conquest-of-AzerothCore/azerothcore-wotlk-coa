    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "assert",
      "label": "CONTROL: the clicker stands 12 yards from the boon",
      "actor": "hero",
      "metric": "distance",
      "target": "boon",
      "min": 11.5
    },
    {
      "action": "gossip_hello",
      "actor": "hero",
      "target": "boon"
    },
    {
      "action": "assert",
      "label": "the ally beside the clicker sees Mythical Blessing's Holy Nova",
      "actor": "ally",
      "metric": "spell_go_count",
      "spell": 2104919,
      "caster": "hero",
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "assert",
      "label": "the clicker gets one boon item",
      "actor": "hero",
      "metric": "carried_item_count",
      "relative_to": "hero_items",
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "assert",
      "label": "the clicker's new item is a Mythical Boon",
      "actor": "hero",
      "metric": "item_count",
      "items": [
        2104920,
