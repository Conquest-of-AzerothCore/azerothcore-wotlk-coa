{
  "schema": 1,
  "name": "Mythical Boon: a click from 12 yards, where the client allows it, still picks the boon up",
  "contract": [
    "The boon orb is drawn 3.5 times its size, so the client lets players click it from about 15 yards away.",
    "The server used to drop such a click without a word unless the player stood within 5.5 yards of the orb's edge.",
    "A click from 12 yards now picks the boon up like a click from beside it."
  ],
  "timeout_ms": 120000,
