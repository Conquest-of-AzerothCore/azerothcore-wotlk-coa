    },
    {
      "action": "use_item",
      "actor": "hero",
      "item": 1233152,
      "spell": 161
    },
    {
      "action": "assert",
      "label": "CONTROL: socket window",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2310,
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "client_packet",
      "actor": "hero",
      "opcode": 1319
    },
    {
      "action": "assert",
      "label": "CONTROL: Start Keystone starts the countdown",
      "actor": "ally",
      "metric": "rooted",
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "wait",
      "ms": 10500
    },
    {
      "action": "assert",
      "label": "CONTROL: the run is under way",
      "actor": "hero",
      "metric": "rooted",
      "equals": 0,
      "within_ms": 2000
    },
    {
      "action": "teleport",
      "actor": "far",
      "map": 189,
      "x": 1707.79,
      "y": -338.49,
      "z": 18.68
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "assert",
      "label": "CONTROL: the third member stands beyond 50 yards",
      "actor": "far",
      "metric": "distance",
      "target": "hero",
      "min": 60
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "carried_item_count",
      "save_as": "hero_items"
    },
    {
      "action": "snapshot",
      "actor": "ally",
      "metric": "carried_item_count",
