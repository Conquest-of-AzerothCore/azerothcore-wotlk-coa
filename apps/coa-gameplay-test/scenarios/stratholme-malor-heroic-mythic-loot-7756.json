{
  "schema": 1,
  "name": "Heroic and Mythic Malor the Zealous use their own loot lists, not the Normal one (#7756)",
  "contract": [
    "#7756: Malor the Zealous on Heroic (111032) and Mythic (211032) rolled his Normal list (11032), so a Heroic kill",
    "dropped world-drop greens, cloth and food. As on Ascension, each now has its own list: the boss sigil (1 %), a",
    "Worldforged Key Fragment (6 %) and, at 25 %, one item of the Heroic or Mythic dungeon pool. No common, uncommon",
    "or rare item is left on the corpse."
  ],
  "timeout_ms": 120000,
  "location": {"map": 0, "x": -8914.0, "y": -133.0, "z": 80.6},
  "players": [
    {"id": "heroic", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000},
    {"id": "mythic", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000}
  ],
  "steps": [
    {"action": "wait", "ms": 1000},
    {"action": "assert", "label": "Heroic Malor has his own loot list", "actor": "heroic",
     "metric": "creature_loot_quality_rate", "entry": 111032, "min": 25, "max": 36},
    {"action": "assert", "label": "Mythic Malor has his own loot list", "actor": "mythic",
     "metric": "creature_loot_quality_rate", "entry": 211032, "min": 25, "max": 36},
    {"action": "set_health", "actor": "heroic", "value": 5000000, "maximum": 5000000},
    {"action": "dungeon_difficulty_packet", "actor": "heroic", "value": 1},
    {"action": "wait", "ms": 250},
    {"action": "teleport", "actor": "heroic", "map": 329, "x": 3660.48, "y": -3505.01, "z": 137.699},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "CONTROL: Stratholme on Heroic", "actor": "heroic", "metric": "map_difficulty",
     "equals": 1},
    {"action": "summon", "actor": "heroic", "entry": 11032, "as": "malorh", "distance": 4},
    {"action": "wait", "ms": 300},
    {"action": "assert", "label": "CONTROL: the Heroic template", "actor": "heroic",
     "metric": "nearby_creature_template", "entry": 11032, "equals": 111032},
    {"action": "attack_nearby", "actor": "heroic", "entry": 11032, "kill": true},
    {"action": "assert", "actor": "malorh", "metric": "alive", "equals": 0, "within_ms": 15000},
    {"action": "loot_creature", "actor": "heroic", "target": "malorh"},
    {"action": "assert", "label": "No Normal loot (common items)", "actor": "heroic", "metric": "loot_count",
     "quality": 1, "equals": 0},
    {"action": "assert", "label": "No Normal loot (uncommon items)", "actor": "heroic", "metric": "loot_count",
     "quality": 2, "equals": 0},
    {"action": "assert", "label": "No Normal loot (rare items)", "actor": "heroic", "metric": "loot_count",
     "quality": 3, "equals": 0},
    {"action": "close_loot", "actor": "heroic"},
    {"action": "set_health", "actor": "mythic", "value": 5000000, "maximum": 5000000},
    {"action": "ascension_dungeon_difficulty_packet", "actor": "mythic", "value": 2},
    {"action": "wait", "ms": 250},
    {"action": "teleport", "actor": "mythic", "map": 329, "x": 3660.48, "y": -3505.01, "z": 137.699},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "CONTROL: Stratholme on Mythic", "actor": "mythic", "metric": "map_difficulty",
     "equals": 2},
    {"action": "summon", "actor": "mythic", "entry": 11032, "as": "malorm", "distance": 4},
    {"action": "wait", "ms": 300},
    {"action": "assert", "label": "CONTROL: the Mythic template", "actor": "mythic",
     "metric": "nearby_creature_template", "entry": 11032, "equals": 211032},
    {"action": "attack_nearby", "actor": "mythic", "entry": 11032, "kill": true},
    {"action": "assert", "actor": "malorm", "metric": "alive", "equals": 0, "within_ms": 15000},
    {"action": "loot_creature", "actor": "mythic", "target": "malorm"},
    {"action": "assert", "label": "No Normal loot (common items)", "actor": "mythic", "metric": "loot_count",
     "quality": 1, "equals": 0},
    {"action": "assert", "label": "No Normal loot (rare items)", "actor": "mythic", "metric": "loot_count",
     "quality": 3, "equals": 0},
    {"action": "close_loot", "actor": "mythic"}
  ]
