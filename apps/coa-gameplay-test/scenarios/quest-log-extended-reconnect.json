          "u8": 1
        },
        {
          "u8": 64
        }
      ]
    },
    {
      "action": "assert",
      "label": "After its own HELLO the new client receives a snapshot",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "within_ms": 2000,
      "equals": 2
    },
    {
      "action": "assert",
      "label": "The new snapshot is full",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 1,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The new snapshot carries the kill",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 13,
      "equals": 1
    }
