      "ms": 9000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: no bolt lands after the shade dies",
      "actor": "raider",
      "metric": "spell_damage_count",
      "caster": "shade",
      "spell": 2118551,
      "target": "raider",
      "relative_to": "bolts_at_death",
      "equals": 0
