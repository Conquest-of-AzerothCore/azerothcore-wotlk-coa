{
  "schema": 1,
  "name": "A boss that leaves its leash on Heroic resets: it announces it, vanishes and returns 10 s later at full health",
  "contract": [
    "Our tester asked for a real reset instead of a walk home. When a leashed boss leaves its area on Heroic or above,",
    "every player in the instance sees '<boss> has lost interest in fighting with you.' near the middle of the screen",
    "for a few seconds and in chat. The boss leaves combat, vanishes at once and comes back at its spawn point",
    "about 10 s later, at full health and attackable. Here Vosh'gajin (9236) has a 15-yard circle in a Heroic",
    "Lower Blackrock Spire."
  ],
  "timeout_ms": 120000,
  "location": { "map": 0, "x": -8914.0, "y": -133.0, "z": 80.6, "o": 0.0 },
  "players": [
    { "id": "gm", "race": 1, "class": 1, "level": 60, "security": 2, "melee_hit_rating": 10000 }
  ],
  "steps": [
    { "action": "wait", "ms": 1000 },
    { "action": "ascension_dungeon_difficulty_packet", "actor": "gm", "value": 1 },
    { "action": "wait", "ms": 500 },
    { "action": "teleport", "actor": "gm", "map": 229, "x": 78.5083, "y": -225.044, "z": 49.839, "o": 5.1 },
    { "action": "assert", "label": "CONTROL: gm is in a Heroic Lower Blackrock Spire", "actor": "gm", "metric": "map_difficulty",
      "equals": 1, "within_ms": 15000 },
    { "action": "wait", "ms": 1500 },
    { "action": "set_health", "actor": "gm", "value": 100000000, "maximum": 100000000 },
    { "action": "command", "actor": "gm", "command": ".leash radius 15 9236" },
    { "action": "summon", "actor": "gm", "as": "boss", "entry": 9236, "distance": 4 },
    { "action": "attack", "actor": "gm", "target": "boss" },
    { "action": "assert", "label": "CONTROL: the boss is in combat", "actor": "boss", "metric": "combat", "equals": 1,
      "within_ms": 10000 },
    { "action": "set_health", "actor": "boss", "value": 1000 },
    { "action": "assert", "label": "CONTROL: the boss is hurt", "actor": "boss", "metric": "health_pct", "max": 99 },
    { "action": "assert", "label": "CONTROL: the boss is visible before the reset", "actor": "gm",
      "metric": "nearby_creature_at_client", "entry": 9236, "equals": 1 },
    { "action": "snapshot", "actor": "gm", "metric": "monster_chat_count", "save_as": "chats" },
    { "action": "snapshot", "actor": "gm", "metric": "server_packets", "opcode": 459, "save_as": "notes" },
    { "action": "relocate", "actor": "gm", "dx": 3.8, "dy": -18.0, "dz": 5.5 },
    { "action": "wait", "ms": 1500 },
    { "action": "relocate", "actor": "gm", "dx": 3.7, "dy": -18.4, "dz": 5.4 },
    { "action": "assert", "label": "The boss vanishes once she leaves the circle", "actor": "gm",
      "metric": "nearby_creature_at_client", "entry": 9236, "equals": 0, "within_ms": 20000 },
    { "action": "assert", "label": "Her reset is announced to the gm", "actor": "gm", "metric": "monster_chat_count",
      "relative_to": "chats", "equals": 1, "within_ms": 1000 },
    { "action": "assert", "label": "and shown on screen as a notification, which fades after a few seconds", "actor": "gm",
      "metric": "server_packets", "opcode": 459, "relative_to": "notes", "equals": 1 },
    { "action": "assert", "label": "The gm leaves combat with her", "actor": "gm", "metric": "combat", "equals": 0,
      "within_ms": 3000 },
    { "action": "assert", "label": "She cannot be attacked while gone", "actor": "gm", "metric": "nearby_creature_can_attack",
      "entry": 9236, "equals": 0 },
    { "action": "wait", "ms": 7000 },
    { "action": "assert", "label": "She is still gone 7 s later", "actor": "gm", "metric": "nearby_creature_at_client",
      "entry": 9236, "equals": 0 },
    { "action": "assert", "label": "She returns about 10 s after the reset", "actor": "gm", "metric": "nearby_creature_at_client",
      "entry": 9236, "equals": 1, "within_ms": 5000 },
    { "action": "assert", "label": "She returns at full health", "actor": "boss", "metric": "health_pct", "equals": 100 },
    { "action": "assert", "label": "She can be attacked again", "actor": "gm", "metric": "nearby_creature_can_attack",
      "entry": 9236, "equals": 1 },
    { "action": "assert", "label": "She is not in combat", "actor": "boss", "metric": "combat", "equals": 0 },
    { "action": "command", "actor": "gm", "command": ".leash clear 9236" }
  ]
}
