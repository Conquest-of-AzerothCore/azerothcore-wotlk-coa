      "opcode": 288,
      "index": 0,
      "equals": 3,
      "within_ms": 1000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: and for the other Human",
      "actor": "other",
      "metric": "server_packet_u32",
      "opcode": 288,
      "index": 0,
      "equals": 3
    },
    {
      "action": "snapshot",
      "actor": "other",
