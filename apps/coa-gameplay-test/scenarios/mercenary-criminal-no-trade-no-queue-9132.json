{
  "schema": 1,
  "name": "Criminal: Blood On Your Hands cancels and refuses trades and takes its bearer out of every queue (#9132)",
  "contract": [
    "Issue #9132. The 9930873 tooltip says its bearer cannot trade with other players while active, and the PR",
    "author's ruling (2026-11-25) removes the player from battleground and Dungeon Finder queues as soon as the",
    "debuff lands. An open trade is cancelled for both sides (SMSG_TRADE_STATUS 3), no trade request to or from",
    "the Criminal arrives, a queued player gets a Warsong Gulch STATUS_NONE status and leaves the Dungeon Finder",
    "queue, and rejoining either queue is refused while Criminal lasts. The core refuses a Dungeon Finder join",
    "while queued for a battleground, so a second Human uses it. A group member who turns Criminal during the",
    "Dungeon Finder role check ends it for the whole group."
  ],
  "timeout_ms": 120000,
  "players": [
    {
      "id": "trader",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "other",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "queuer",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "seeker",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "leader",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "member",
      "race": 1,
      "class": 1,
      "level": 60
    }
  ],
  "location": {
    "map": 0,
    "x": -9465,
    "y": 64,
    "z": 56,
    "o": 0
  },
  "steps": [
