{
  "schema": 1,
  "name": "Tome of Sundered Souls procs on damaging spells (#12286)",
  "contract": [
    "#12286: Tome of Sundered Souls (proc dummies 304096, 313152, 317152, 321152) never procced. Every dummy",
    "carries Spell.dbc ProcFlags 0 and the world had no spell_proc row, so SpellMgr::LoadSpellProcs skipped it.",
    "Tooltip: \"Damaging spells\", tiers \"(20sec. internal cooldown)\". Flags 69632 as the merged D1 Magister",
    "3-piece row for \"Casting damaging spells\". spell_proc_chance reads each loaded entry's chance, which equals",
    "the record's ProcChance, and spell_proc_cooldown_ms reads each loaded cooldown. aura_proc_rate replays the",
    "aura's native proc decision, including the roll, 40000 times on one synthetic event per check. It procs on a",
    "landed direct magic spell (Frostbolt 116), at the record's chance; it never procs on a landed melee ability",
    "(Heroic Strike 78), a periodic Shadow tick (Shadow Word: Pain 589). Before the repair the chance and",
    "cooldown lookups fail with 'Spell has no proc entry' and every rate reads 0, so the discriminating checks",
    "fail instead of flaking."
  ],
  "timeout_ms": 60000,
  "players": [
    {
      "id": "caster",
      "race": 1,
      "class": 1,
      "level": 80,
      "allow_regeneration": false
    }
  ],
  "creatures": [
    {
      "id": "dummy",
      "owner": "caster",
      "entry": 36,
      "level": 80,
      "health": 1000000,
      "distance": 4
    }
  ],
  "steps": [
    {
      "action": "wait",
      "label": "Let spawn AI and level scaling settle",
      "ms": 5000
    },
    {
      "action": "set_aura",
      "label": "Proc dummy 304096",
      "actor": "caster",
      "spell": 304096,
      "stacks": 1
    },
    {
      "action": "set_aura",
      "label": "Proc dummy 321152",
      "actor": "caster",
      "spell": 321152,
      "stacks": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 304096 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 304096,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 321152 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 321152,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 304096 loads the record's 15% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 304096,
      "equals": 15
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 313152 loads the record's 15% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 313152,
      "equals": 15
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 317152 loads the record's 15% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 317152,
      "equals": 15
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 321152 loads the record's 15% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 321152,
      "equals": 15
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 304096 loads no internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 304096,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 313152 loads the tooltip's 20 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 313152,
      "equals": 20000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 317152 loads the tooltip's 20 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 317152,
      "equals": 20000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 321152 loads the tooltip's 20 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 321152,
      "equals": 20000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: a landed direct magic spell (Frostbolt 116) procs 304096 at 15%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 304096,
      "target": "dummy",
      "trigger_spell": 116,
      "type_mask": 65536,
      "phase_mask": 2,
      "spell_type_mask": 1,
      "hit_mask": 1,
      "min": 13.5,
      "max": 16.5
    },
    {
