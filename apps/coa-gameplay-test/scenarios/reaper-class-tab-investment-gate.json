{
  "schema": 1,
  "name": "reaper-class-tab-investment-gate",
  "contract": [
    "CharacterAdvancement TabAEInvestment/TabTEInvestment (byte offsets 152/156) gate a row behind the",
    "AE/TE already spent on shallower rows of the same tab. Reaper (class 30) class tab has 13 entries at",
    "TabAEInvestment 0 and entry 5495 (spell 572340) at TabAEInvestment 9. Buying 5495 with nothing invested",
    "is refused; investing 9 class points makes it purchasable; removing one of those 9 points while 5495",
    "stays wanted is refused and leaves both ranks untouched."
  ],
  "timeout_ms": 120000,
  "players": [
    {
      "id": "reaper",
      "race": 1,
      "class": 30,
      "level": 60
    }
  ],
  "steps": [
    { "action": "wait", "ms": 3000 },
    {
      "action": "advancement_rank", "actor": "reaper", "entry": 5495, "rank": 1, "refused": true
    },
    {
      "action": "assert", "actor": "reaper", "metric": "knows_spell", "spell": 572340, "equals": 0,
      "label": "Buying a gated entry with nothing invested below it is refused"
    },
    { "action": "advancement_rank", "actor": "reaper", "entry": 6708, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 6719, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 6722, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 6778, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 9322, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 29248, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 30107, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 30109, "rank": 1 },
    { "action": "advancement_rank", "actor": "reaper", "entry": 30113, "rank": 1 },
    {
      "action": "assert", "actor": "reaper", "metric": "knows_spell", "spell": 500483, "equals": 1,
      "label": "Nine rank-0 class entries are now purchased"
    },
    {
      "action": "advancement_rank", "actor": "reaper", "entry": 5495, "rank": 1
    },
    {
      "action": "assert", "actor": "reaper", "metric": "knows_spell", "spell": 572340, "equals": 1,
      "label": "Investing the required 9 class points unlocks the gated entry"
    },
    {
      "action": "advancement_rank", "actor": "reaper", "entry": 6708, "rank": 0, "refused": true
    },
    {
      "action": "assert", "actor": "reaper", "metric": "knows_spell", "spell": 706790, "equals": 1,
      "label": "Removing a rank-0 point that would break the gate is refused"
    },
    {
      "action": "assert", "actor": "reaper", "metric": "knows_spell", "spell": 572340, "equals": 1,
      "label": "The gated entry stays known after the refused removal"
    }
  ]
}
