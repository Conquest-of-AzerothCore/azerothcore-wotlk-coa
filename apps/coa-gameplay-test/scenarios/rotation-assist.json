{
  "schema": 1,
  "name": "Rotation assistance: one press, ordinary spell checks and no background casts",
  "contract": [
    "With CoA.RotationAssist.Enable=1, an ordinary player without a CoA specialization can use .rotation on a",
    "selected enemy. With only Frostbolt learned, one press causes one normal Frostbolt, spends mana and",
    "applies its slow. A second press during that cast does not queue another. Waiting does not cast again; an",
    "empty mana bar prevents an attack. A friendly selection produces no harmful spell. A priest selecting",
    "themself at low health casts one normal Lesser Heal, with no repeated healing after waiting. This",
    "verifies the generic fallback and native command boundary, not every specialization priority or client",
    "macro rendering. A subsequent learned Fire Blast tests the global cooldown and falling through its spell",
    "cooldown to Frostbolt."
  ],
  "timeout_ms": 60000,
  "players": [
    {
      "id": "caster",
      "race": 1,
      "class": 8,
      "level": 1,
      "spell_hit_rating": 10000
    },
    {
      "id": "healer",
      "race": 1,
      "class": 5,
      "level": 1
    }
  ],
  "creatures": [
    {
      "id": "target",
      "owner": "caster",
      "entry": 36,
      "level": 1,
      "health": 100000,
      "distance": 3
    }
  ],
