      "label": "Enter Ragefire Chasm (map 1 -> map 389)",
      "actor": "pyro",
      "id": 2230
    },
    {
      "action": "assert",
      "label": "Arrived in Ragefire Chasm (map 389)",
      "actor": "pyro",
      "metric": "map_id",
      "equals": 389,
      "within_ms": 12000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: Phoenix survives dungeon entry",
      "actor": "pyro",
