      "label": "Arrived back in Orgrimmar (map 1)",
      "actor": "pyro",
      "metric": "map_id",
      "equals": 1,
      "within_ms": 12000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: Phoenix survives dungeon exit (recreated summon kept spellId)",
      "actor": "pyro",
      "metric": "owned_creature_count",
      "entry": 50258,
      "equals": 1,
      "within_ms": 5000
