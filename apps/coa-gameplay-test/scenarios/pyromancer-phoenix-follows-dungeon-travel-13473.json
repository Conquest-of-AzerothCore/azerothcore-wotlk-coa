      "entry": 50258,
      "equals": 1,
      "within_ms": 5000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: Phoenix remains active pet after dungeon entry",
      "actor": "pyro",
      "metric": "pet_entry",
      "equals": 50258,
      "within_ms": 5000
    },
    {
      "action": "teleport",
      "label": "Step to Ragefire Chasm exit portal",
      "actor": "pyro",
