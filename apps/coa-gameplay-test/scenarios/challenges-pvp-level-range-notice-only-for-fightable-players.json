    { "action": "start_challenge", "actor": "ironman", "challenge": 52, "level": 1 },
    { "action": "wait", "ms": 1500 },
    { "action": "assert", "label": "Ironman starts", "actor": "ironman", "metric": "challenge_start_code", "equals": 0 },
    { "action": "teleport", "actor": "ironman", "map": 0, "x": -9617.06, "y": -288.949, "z": 57.3053, "o": 0 },
    { "action": "teleport", "actor": "ally", "map": 0, "x": -9615.06, "y": -288.949, "z": 57.3053, "o": 0 },
    { "action": "teleport", "actor": "enemy", "map": 0, "x": -9577.06, "y": -288.949, "z": 57.3053, "o": 0 },
    { "action": "pvp", "actor": "ironman", "enabled": true },
    { "action": "pvp", "actor": "enemy", "enabled": true },
    { "action": "learn", "actor": "ironman", "spell": 6343 },
    { "action": "set_power", "actor": "ironman", "power": 1, "value": 1000 },
    { "action": "wait", "ms": 500 },
    { "action": "cast", "actor": "ironman", "spell": 6343 },
    { "action": "assert", "label": "Thunder Clap is cast", "actor": "ironman", "metric": "spell_cast_count",
