  "players": [
    { "id": "ironman", "race": 1, "class": 1, "level": 1 },
    { "id": "ally", "race": 1, "class": 1, "level": 10 },
    { "id": "enemy", "race": 2, "class": 1, "level": 10 }
  ],
  "steps": [
