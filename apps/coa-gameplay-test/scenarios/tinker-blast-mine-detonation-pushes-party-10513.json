{
  "schema": 1,
  "name": "Blast Mine detonation pushes the Tinker and party members away without harming them (#10513)",
  "contract": [
    "Deploy Blast Mine 801718: 'When the mine is destroyed, or upon using Remote Detonation, up to $802336i nearby",
    "targets are blasted away and enemies take a minor amount of Fire damage.' Remote Bomb Explosion 802336 damages",
    "and knocks back enemies, and its effect 2 triggers Remote Bomb Knockback 804306 (a weaker knock back, no damage)",
    "on TARGET_UNIT_DEST_AREA_PARTY within its 8 yd radius. Expected with a mine 3 yd away and Remote Detonation 801798:",
    "the Tinker and a grouped player each receive exactly one SMSG_MOVE_KNOCK_BACK (239) and lose no health; an",
    "ungrouped player at the same spot receives none."
  ],
  "timeout_ms": 90000,
  "players": [
    {"id": "tinker", "race": 1, "class": 28, "level": 6},
    {"id": "friend", "race": 1, "class": 28, "level": 6},
    {"id": "stranger", "race": 1, "class": 28, "level": 6}
  ],
  "location": {"map": 0, "x": -8917.41, "y": -115.853, "z": 82.3711, "o": 0},
  "steps": [
    {"action": "wait", "label": "Let login and level scaling settle", "ms": 5000},
    {"action": "learn", "label": "Deploy Blast Mine", "actor": "tinker", "spell": 801718},
    {"action": "group", "label": "The friend joins the Tinker's party", "actor": "tinker", "target": "friend"},
    {"action": "assert", "label": "Remote Detonation is known with Deploy Blast Mine", "actor": "tinker",
     "metric": "knows_spell", "spell": 801798, "equals": 1, "within_ms": 2000},
    {"action": "cast", "label": "Deploy the mine 3 yd from the players", "actor": "tinker", "spell": 801718,
     "destination": {"x": -8914.41, "y": -115.853, "z": 82.3711}},
    {"action": "assert", "label": "One Blast Mine is placed", "actor": "tinker", "metric": "owned_creature_count",
     "entry": 50045, "equals": 1, "within_ms": 2000},
    {"action": "assert", "label": "SETUP: the mine grants Bomb Ready", "actor": "tinker", "metric": "aura",
     "spell": 500354, "equals": 1, "within_ms": 2000},
    {"action": "snapshot", "actor": "tinker", "metric": "server_packets", "opcode": 239,
     "save_as": "tinker_knockbacks"},
    {"action": "snapshot", "actor": "friend", "metric": "server_packets", "opcode": 239,
     "save_as": "friend_knockbacks"},
    {"action": "snapshot", "actor": "stranger", "metric": "server_packets", "opcode": 239,
     "save_as": "stranger_knockbacks"},
    {"action": "snapshot", "actor": "tinker", "metric": "health", "save_as": "tinker_health"},
    {"action": "snapshot", "actor": "friend", "metric": "health", "save_as": "friend_health"},
    {"action": "cast", "label": "Remote Detonation", "actor": "tinker", "spell": 801798},
    {"action": "assert", "label": "The detonated mine is gone", "actor": "tinker", "metric": "owned_creature_count",
     "entry": 50045, "equals": 0, "within_ms": 2000},
    {"action": "assert", "label": "CONTRACT: the Tinker is blasted away once", "actor": "tinker",
     "metric": "server_packets", "opcode": 239, "relative_to": "tinker_knockbacks", "equals": 1, "within_ms": 3000},
    {"action": "assert", "label": "CONTRACT: the party member is blasted away once", "actor": "friend",
     "metric": "server_packets", "opcode": 239, "relative_to": "friend_knockbacks", "equals": 1, "within_ms": 3000},
    {"action": "wait", "ms": 1000},
    {"action": "assert", "label": "CONTRACT: a player outside the party is not pushed", "actor": "stranger",
     "metric": "server_packets", "opcode": 239, "relative_to": "stranger_knockbacks", "equals": 0},
    {"action": "assert", "label": "CONTRACT: the Tinker takes no damage", "actor": "tinker", "metric": "health",
     "relative_to": "tinker_health", "equals": 0},
    {"action": "assert", "label": "CONTRACT: the party member takes no damage", "actor": "friend", "metric": "health",
     "relative_to": "friend_health", "equals": 0},
    {"action": "assert", "label": "The Tinker's knock back stays single", "actor": "tinker",
     "metric": "server_packets", "opcode": 239, "relative_to": "tinker_knockbacks", "equals": 1}
  ]
}
