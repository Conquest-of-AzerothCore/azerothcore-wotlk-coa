{
  "schema": 1,
  "name": "Blackrock Depths: the Ring of Law bosses use their own Heroic and Mythic templates (#8360)",
  "contract": [
    "#8360: on Mythic the Ring of Law bosses dropped their Normal loot (rare item level 57) and had about 100000",
    "health, because they had no Heroic or Mythic template. They now have level 63 copies at entry + 100000 / + 200000",
    "with their own loot lists and the non-final boss health model: Hedrum the Creeper on Mythic is 209032 with",
    "541700 health and drops exactly one epic of item level 64; on Heroic he is 109032 with 416692 health and drops",
    "one of item level 61."
  ],
  "timeout_ms": 120000,
  "location": {"map": 0, "x": -8914.0, "y": -133.0, "z": 80.6},
  "players": [
    {"id": "mythic", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000},
    {"id": "heroic", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000}
  ],
  "steps": [
    {"action": "wait", "ms": 1000},
    {"action": "set_health", "actor": "mythic", "value": 5000000, "maximum": 5000000},
    {"action": "ascension_dungeon_difficulty_packet", "actor": "mythic", "value": 2},
    {"action": "wait", "ms": 250},
    {"action": "teleport", "actor": "mythic", "map": 230, "x": 730.85, "y": -68.85, "z": -72.0},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "CONTROL: Blackrock Depths on Mythic", "actor": "mythic",
     "metric": "map_difficulty", "equals": 2},
    {"action": "summon", "actor": "mythic", "entry": 9032, "as": "hedrum_mythic", "distance": 4},
    {"action": "wait", "ms": 300},
    {"action": "assert", "label": "Hedrum uses his Mythic template", "actor": "mythic",
     "metric": "nearby_creature_template", "entry": 9032, "equals": 209032},
    {"action": "assert", "label": "Hedrum has 541700 health on Mythic", "actor": "mythic",
     "metric": "nearby_creature_max_health", "entry": 9032, "equals": 541700, "within_ms": 5000},
    {"action": "attack_nearby", "actor": "mythic", "entry": 9032, "kill": true},
    {"action": "assert", "label": "Hedrum dies", "actor": "hedrum_mythic", "metric": "alive", "equals": 0,
     "within_ms": 15000},
    {"action": "loot_creature", "actor": "mythic", "target": "hedrum_mythic"},
    {"action": "assert", "label": "One epic item on the Mythic corpse", "actor": "mythic", "metric": "loot_count",
     "quality": 4, "equals": 1},
    {"action": "assert", "label": "It is a Mythic item of the Ring of Law pool (item level 64)", "actor": "mythic",
     "metric": "loot_gear_item_level", "equals": 64},
    {"action": "close_loot", "actor": "mythic"},
    {"action": "set_health", "actor": "heroic", "value": 5000000, "maximum": 5000000},
    {"action": "dungeon_difficulty_packet", "actor": "heroic", "value": 1},
    {"action": "wait", "ms": 250},
    {"action": "teleport", "actor": "heroic", "map": 230, "x": 730.85, "y": -68.85, "z": -72.0},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "CONTROL: Blackrock Depths on Heroic", "actor": "heroic",
     "metric": "map_difficulty", "equals": 1},
    {"action": "summon", "actor": "heroic", "entry": 9032, "as": "hedrum_heroic", "distance": 4},
    {"action": "wait", "ms": 300},
    {"action": "assert", "label": "Hedrum uses his Heroic template", "actor": "heroic",
     "metric": "nearby_creature_template", "entry": 9032, "equals": 109032},
    {"action": "assert", "label": "Hedrum has 416692 health on Heroic", "actor": "heroic",
     "metric": "nearby_creature_max_health", "entry": 9032, "equals": 416692, "within_ms": 5000},
    {"action": "attack_nearby", "actor": "heroic", "entry": 9032, "kill": true},
    {"action": "assert", "label": "Hedrum dies", "actor": "hedrum_heroic", "metric": "alive", "equals": 0,
     "within_ms": 15000},
    {"action": "loot_creature", "actor": "heroic", "target": "hedrum_heroic"},
    {"action": "assert", "label": "One epic item on the Heroic corpse", "actor": "heroic", "metric": "loot_count",
     "quality": 4, "equals": 1},
    {"action": "assert", "label": "It is a Heroic item of the Ring of Law pool (item level 61)", "actor": "heroic",
     "metric": "loot_gear_item_level", "equals": 61},
    {"action": "close_loot", "actor": "heroic"}
  ]
}
