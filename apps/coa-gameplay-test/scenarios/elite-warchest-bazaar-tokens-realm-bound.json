{
  "schema": 1,
  "name": "Elite Warchest Bazaar Tokens are Realm Bound: spent first, free between own characters",
  "contract": [
    "The 1500 Bazaar Tokens (975001) from the Conquest of Azeroth Elite Warchest (2977351) are a per-account reserve.",
    "They cannot be mailed to another account, but the account's own characters can receive them. Farmed tokens stay",
    "tradeable, and tokens that are spent or destroyed use up the reserve first: with 1500 warchest tokens and 500",
    "farmed, losing 600 leaves 900 reserved and 500 free, so 500 tokens can be mailed to another account but the",
    "remaining 900 cannot, and those 900 can still go to the account's own alt."
  ],
  "timeout_ms": 60000,
  "location": {"map": 0, "x": -9465, "y": 64, "z": 56, "o": 0},
  "players": [
    {"id": "hero", "name": "Coatokenhero", "race": 1, "class": 1, "level": 10},
    {"id": "alt", "name": "Coatokenalt", "race": 1, "class": 1, "level": 1, "account_of": "hero"},
    {"id": "other", "name": "Coatokenoth", "race": 1, "class": 1, "level": 1}
  ],
  "steps": [
    {"action": "wait", "ms": 1000},
    {"action": "add_item", "actor": "hero", "item": 4500},
    {"action": "equip", "actor": "hero", "item": 4500, "slot": 19},
    {"action": "add_item", "actor": "hero", "item": 4499},
    {"action": "equip", "actor": "hero", "item": 4499, "slot": 20},
    {"action": "add_item", "actor": "hero", "item": 14046},
    {"action": "equip", "actor": "hero", "item": 14046, "slot": 21},
    {"action": "add_item", "actor": "hero", "item": 21841},
    {"action": "equip", "actor": "hero", "item": 21841, "slot": 22},
    {"action": "summon_gameobject", "actor": "hero", "entry": 142119},
    {"action": "money", "actor": "hero", "copper": 10000},

    {"action": "add_item", "actor": "hero", "item": 2977351},
    {"action": "use_item", "label": "Open the Elite Warchest", "actor": "hero", "item": 2977351, "spell": 93461},
    {"action": "assert", "label": "The warchest gives 1500 Bazaar Tokens", "actor": "hero", "metric": "item_count",
     "item": 975001, "equals": 1500, "within_ms": 2000},

    {"action": "client_packet", "label": "Mail the 1500 warchest tokens to another account", "actor": "hero",
     "opcode": 568, "consumed": false,
     "fields": [{"gameobject_guid": 142119}, {"string": "Coatokenoth"}, {"string": "Tokens"}, {"string": "Realm bound"},
                {"u32": 41}, {"u32": 0}, {"u8": 1}, {"u8": 0}, {"item_guid": 975001}, {"u32": 0}, {"u32": 0},
                {"u64": 0}, {"u8": 0}]},
    {"action": "assert", "label": "DISCRIMINATING: warchest tokens cannot be mailed to another account", "actor": "hero",
     "metric": "server_packet_u32", "opcode": 569, "index": 2, "equals": 1},
    {"action": "assert", "label": "The tokens stay with the sender", "actor": "hero", "metric": "item_count",
     "item": 975001, "equals": 1500},
    {"action": "assert", "label": "The refusal is explained", "actor": "hero", "metric": "system_messages", "min": 1},

    {"action": "add_item", "label": "500 farmed tokens join the stack", "actor": "hero", "item": 975001, "count": 500},
    {"action": "client_packet", "label": "Split 1400 into the last slot of the fourth bag", "actor": "hero",
     "opcode": 270, "consumed": false,
     "fields": [{"item_bag": 975001}, {"item_slot": 975001}, {"u8": 22}, {"u8": 15}, {"u32": 1400}]},
    {"action": "destroy_item", "label": "Lose the other 600 tokens", "actor": "hero", "item": 975001},
    {"action": "assert", "label": "1400 tokens left", "actor": "hero", "metric": "item_count", "item": 975001,
     "equals": 1400, "within_ms": 1000},

    {"action": "client_packet", "label": "Split 500 off into the slot before it", "actor": "hero", "opcode": 270,
     "consumed": false,
     "fields": [{"item_bag": 975001}, {"item_slot": 975001}, {"u8": 22}, {"u8": 14}, {"u32": 500}]},
    {"action": "client_packet", "label": "Mail the 500 free tokens to another account", "actor": "hero",
     "opcode": 568, "consumed": false,
     "fields": [{"gameobject_guid": 142119}, {"string": "Coatokenoth"}, {"string": "Tokens"}, {"string": "Free"},
                {"u32": 41}, {"u32": 0}, {"u8": 1}, {"u8": 0}, {"item_guid": 975001}, {"u32": 0}, {"u32": 0},
                {"u64": 0}, {"u8": 0}]},
    {"action": "assert", "label": "DISCRIMINATING: the reserve was spent first, so 500 tokens are free", "actor": "hero",
     "metric": "server_packet_u32", "opcode": 569, "index": 2, "equals": 0},
    {"action": "assert", "label": "900 tokens left", "actor": "hero", "metric": "item_count", "item": 975001,
     "equals": 900},

    {"action": "client_packet", "label": "Mail the 900 reserved tokens to another account", "actor": "hero",
     "opcode": 568, "consumed": false,
     "fields": [{"gameobject_guid": 142119}, {"string": "Coatokenoth"}, {"string": "Tokens"}, {"string": "Reserved"},
                {"u32": 41}, {"u32": 0}, {"u8": 1}, {"u8": 0}, {"item_guid": 975001}, {"u32": 0}, {"u32": 0},
                {"u64": 0}, {"u8": 0}]},
    {"action": "assert", "label": "The 900 reserved tokens stay on the account", "actor": "hero",
     "metric": "server_packet_u32", "opcode": 569, "index": 2, "equals": 1},
    {"action": "assert", "label": "Still 900 tokens", "actor": "hero", "metric": "item_count", "item": 975001,
     "equals": 900},

    {"action": "client_packet", "label": "Mail the 900 reserved tokens to the own alt", "actor": "hero",
     "opcode": 568, "consumed": false,
     "fields": [{"gameobject_guid": 142119}, {"string": "Coatokenalt"}, {"string": "Tokens"}, {"string": "Own alt"},
                {"u32": 41}, {"u32": 0}, {"u8": 1}, {"u8": 0}, {"item_guid": 975001}, {"u32": 0}, {"u32": 0},
                {"u64": 0}, {"u8": 0}]},
    {"action": "assert", "label": "Reserved tokens move freely to the own account's alt", "actor": "hero",
     "metric": "server_packet_u32", "opcode": 569, "index": 2, "equals": 0},
    {"action": "assert", "label": "No tokens left on the sender", "actor": "hero", "metric": "item_count",
     "item": 975001, "equals": 0},

    {"action": "relog", "actor": "alt"},
    {"action": "assert", "label": "The alt receives the reserved tokens", "actor": "alt", "metric": "mail_has_item",
     "item": 975001, "equals": 1, "within_ms": 1000},
    {"action": "relog", "actor": "other"},
    {"action": "assert", "label": "The other account receives only the 500 free tokens", "actor": "other",
     "metric": "mail_item_count", "equals": 1, "within_ms": 1000}
  ]
}
