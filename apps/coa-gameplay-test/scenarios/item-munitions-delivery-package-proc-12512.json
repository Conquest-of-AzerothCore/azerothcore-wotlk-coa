      "hit_mask": 1,
      "min": 3.5,
      "max": 6.5
    },
    {
      "action": "assert",
      "label": "CONTROL: a landed melee auto attack procs 303056 at 0%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 303056,
      "target": "dummy",
