      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 320863,
      "target": "dummy",
      "type_mask": 64,
      "phase_mask": 2,
      "spell_type_mask": 1,
      "hit_mask": 1,
      "min": 3.5,
      "max": 6.5
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: a landed ranged ability (Arcane Shot 3044) procs 320863 at 5%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 320863,
      "target": "dummy",
