    {
      "action": "assert",
      "label": "CONTROL: a landed direct magic spell (Frostbolt 116) procs 303056 at 0%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 303056,
      "target": "dummy",
      "trigger_spell": 116,
      "type_mask": 65536,
