{
  "schema": 1,
  "name": "Munitions Delivery Package procs on ranged attacks (#12512, #13063)",
  "contract": [
    "#12512, #13063: Munitions Delivery Package (proc dummies 303056, 312863, 316863, 320863) never procced.",
    "Every dummy carries Spell.dbc ProcFlags 0 and the world had no spell_proc row, so SpellMgr::LoadSpellProcs",
    "skipped it. Tooltip: \"Your ranged attacks\", tiers \"(5sec. internal cooldown)\". Flags 320 (ranged auto",
    "attacks and ranged abilities) as the merged T1 Hunter 6-piece row. spell_proc_chance reads each loaded",
    "entry's chance, which equals the record's ProcChance, and spell_proc_cooldown_ms reads each loaded cooldown.",
    "aura_proc_rate replays the aura's native proc decision, including the roll, 40000 times on one synthetic",
    "event per check. It procs on a landed ranged auto attack, a landed ranged ability (Arcane Shot 3044), at the",
    "record's chance; it never procs on a landed melee auto attack, a landed direct magic spell (Frostbolt 116).",
    "Before the repair the chance and cooldown lookups fail with 'Spell has no proc entry' and every rate reads",
    "0, so the discriminating checks fail instead of flaking."
  ],
  "timeout_ms": 60000,
  "players": [
    {
      "id": "caster",
      "race": 1,
      "class": 1,
      "level": 80,
      "allow_regeneration": false
    }
  ],
  "creatures": [
    {
      "id": "dummy",
      "owner": "caster",
      "entry": 36,
      "level": 80,
      "health": 1000000,
      "distance": 4
    }
  ],
  "steps": [
    {
      "action": "wait",
      "label": "Let spawn AI and level scaling settle",
      "ms": 5000
    },
    {
      "action": "set_aura",
      "label": "Proc dummy 303056",
      "actor": "caster",
      "spell": 303056,
      "stacks": 1
    },
    {
      "action": "set_aura",
      "label": "Proc dummy 320863",
      "actor": "caster",
      "spell": 320863,
      "stacks": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 303056 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 303056,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 320863 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 320863,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 303056 loads the record's 10% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 303056,
      "equals": 10
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312863 loads the record's 5% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 312863,
      "equals": 5
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 316863 loads the record's 5% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 316863,
      "equals": 5
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 320863 loads the record's 5% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 320863,
      "equals": 5
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 303056 loads no internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 303056,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312863 loads the tooltip's 5 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 312863,
      "equals": 5000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 316863 loads the tooltip's 5 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 316863,
      "equals": 5000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 320863 loads the tooltip's 5 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 320863,
      "equals": 5000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: a landed ranged auto attack procs 303056 at 10%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 303056,
      "target": "dummy",
      "type_mask": 64,
      "phase_mask": 2,
      "spell_type_mask": 1,
      "hit_mask": 1,
      "min": 8.5,
      "max": 11.5
    },
    {
      "action": "assert",
