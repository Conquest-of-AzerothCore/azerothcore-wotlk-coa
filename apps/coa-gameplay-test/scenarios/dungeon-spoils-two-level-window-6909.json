{
  "schema": 1,
  "name": "Dungeon Spoils give items within three levels of the opener (#6909)",
  "contract": [
    "#6909: Dungeon Spoils (2021814) opened at level 44 could give an item that requires level 39, five levels",
    "below the opener. The pick keeps only items within three levels of the highest required level the opener",
    "can use, so a level 44 Warrior who opens six spoils gets six items that require level 41-44 and none that",
    "requires level 39-40."
  ],
  "timeout_ms": 90000,
  "location": {
    "map": 0,
    "x": -8914.0,
    "y": -133.0,
    "z": 80.6
  },
  "players": [
    {
      "id": "p1",
      "race": 1,
      "class": 1,
      "level": 44
    }
  ],
  "steps": [
