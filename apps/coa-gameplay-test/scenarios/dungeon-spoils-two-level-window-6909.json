{
  "schema": 1,
  "name": "Dungeon Spoils give items within two levels of the opener (#6909)",
  "contract": [
    "#6909: Dungeon Spoils (2021814) opened at level 44 could give an item that requires level 39, five levels",
    "below the opener. The pick now keeps only items within two levels of the highest required level the opener can",
    "use, so a level 44 Warrior who opens six spoils gets six items that require level 42-44. The pool holds 48 items",
    "that require level 39-41 and 45 that require 42-44, so the old window would put an item below 42 in the bags",
    "about once in every two opens."
  ],
  "timeout_ms": 90000,
  "location": {
    "map": 0,
    "x": -8914.0,
    "y": -133.0,
    "z": 80.6
  },
