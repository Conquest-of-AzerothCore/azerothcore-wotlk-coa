      "actor": "p1",
      "metric": "item_count",
      "item": 2021814,
      "equals": 5,
      "within_ms": 3000
    },
    {
      "action": "open_item",
      "actor": "p1",
      "item": 2021814
    },
    {
      "action": "assert",
      "actor": "p1",
      "metric": "item_count",
      "item": 2021814,
      "equals": 4,
      "within_ms": 3000
    },
    {
      "action": "open_item",
      "actor": "p1",
      "item": 2021814
    },
    {
      "action": "assert",
      "actor": "p1",
      "metric": "item_count",
      "item": 2021814,
      "equals": 3,
      "within_ms": 3000
    },
    {
      "action": "open_item",
      "actor": "p1",
      "item": 2021814
    },
    {
      "action": "assert",
      "actor": "p1",
      "metric": "item_count",
      "item": 2021814,
      "equals": 2,
      "within_ms": 3000
    },
    {
      "action": "open_item",
      "actor": "p1",
      "item": 2021814
    },
    {
      "action": "assert",
      "actor": "p1",
      "metric": "item_count",
      "item": 2021814,
      "equals": 1,
      "within_ms": 3000
    },
    {
      "action": "open_item",
      "actor": "p1",
      "item": 2021814
    },
    {
      "action": "assert",
      "actor": "p1",
      "metric": "item_count",
      "item": 2021814,
      "equals": 0,
      "within_ms": 3000
    },
    {
      "action": "assert",
      "label": "The six spoils put six of their items in p1's bags",
      "actor": "p1",
