{
  "schema": 1,
  "name": "Item scaling: every class but Hero wears the reborn armor its tooltip shows",
  "contract": "Requires CoA.ItemScaling.Native=1 and CoA.ItemScaling.Native.RebornArmor=1 with ItemStat.dbc and ItemAddon.dbc in the data directory, and CoA.QuestLevelScaling=1 for the quest reward. The client shows a scaled item's second ItemStat armor column (reborn armor) to every class but the classless Hero (10), and an unscaled item's ItemAddon.dbc reborn armor; the server applies the same value. Footman Tunic 6085 (mail) given by Wanted: Hogger 176 to a level 30 character stores level 30, whose ItemStat row carries 192 armor and 72 reborn armor, plus 2 agility. Tribal Vest 3288 (mail, 128 armor, 2 agility) has no scaling level when added directly; its ItemAddon.dbc reborn armor is 57. Each point of agility adds 2 armor, so equipping the tunic adds 72 + 4 to a Guardian (18) and 192 + 4 to a Hero; the vest adds 57 + 4 and 128 + 4. Tooltips themselves are not rendered here.",
  "timeout_ms": 90000,
  "players": [
    { "id": "guardian", "race": 1, "class": 18, "level": 30 },
    { "id": "hero", "race": 1, "class": 10, "level": 30 },
    { "id": "guardian_authored", "race": 1, "class": 18, "level": 60 },
    { "id": "hero_authored", "race": 1, "class": 10, "level": 60 }
  ],
  "steps": [
    { "action": "wait", "label": "Let the fixture settle", "ms": 2000 },
    { "action": "learn", "actor": "guardian", "spell": 8737 },
    { "action": "learn", "actor": "hero", "spell": 8737 },
    { "action": "learn", "actor": "guardian_authored", "spell": 8737 },
    { "action": "learn", "actor": "hero_authored", "spell": 8737 },
    { "action": "level_scaling_packet", "actor": "guardian", "value": 1 },
    { "action": "level_scaling_packet", "actor": "hero", "value": 1 },
    { "action": "wait", "ms": 1000 },

    { "action": "prepare_quest", "actor": "guardian", "quest": 176 },
    { "action": "reward_quest", "actor": "guardian", "quest": 176, "choice": 0 },
    { "action": "assert", "label": "The Guardian's tunic stores level 30", "actor": "guardian", "metric": "carried_item_scaling_level", "item": 6085, "equals": 30 },
    { "action": "snapshot", "actor": "guardian", "metric": "armor", "save_as": "guardian_bare" },
    { "action": "equip", "actor": "guardian", "item": 6085, "slot": 4 },
    { "action": "wait", "ms": 500 },
    { "action": "assert", "label": "The scaled tunic gives a Guardian its 72 reborn armor plus 4 from agility", "actor": "guardian", "metric": "armor", "relative_to": "guardian_bare", "equals": 76 },

    { "action": "prepare_quest", "actor": "hero", "quest": 176 },
    { "action": "reward_quest", "actor": "hero", "quest": 176, "choice": 0 },
    { "action": "assert", "label": "The Hero's tunic stores level 30", "actor": "hero", "metric": "carried_item_scaling_level", "item": 6085, "equals": 30 },
    { "action": "snapshot", "actor": "hero", "metric": "armor", "save_as": "hero_bare" },
    { "action": "equip", "actor": "hero", "item": 6085, "slot": 4 },
    { "action": "wait", "ms": 500 },
    { "action": "assert", "label": "The scaled tunic gives a Hero its full 192 armor plus 4 from agility", "actor": "hero", "metric": "armor", "relative_to": "hero_bare", "equals": 196 },

    { "action": "add_item", "actor": "guardian_authored", "item": 3288 },
    { "action": "assert", "label": "The added vest has no scaling level", "actor": "guardian_authored", "metric": "carried_item_scaling_level", "item": 3288, "equals": 0 },
    { "action": "snapshot", "actor": "guardian_authored", "metric": "armor", "save_as": "guardian_authored_bare" },
    { "action": "equip", "actor": "guardian_authored", "item": 3288, "slot": 4 },
    { "action": "wait", "ms": 500 },
    { "action": "assert", "label": "The authored vest gives a Guardian its ItemAddon reborn armor 57 plus 4 from agility", "actor": "guardian_authored", "metric": "armor", "relative_to": "guardian_authored_bare", "equals": 61 },

    { "action": "add_item", "actor": "hero_authored", "item": 3288 },
    { "action": "snapshot", "actor": "hero_authored", "metric": "armor", "save_as": "hero_authored_bare" },
    { "action": "equip", "actor": "hero_authored", "item": 3288, "slot": 4 },
    { "action": "wait", "ms": 500 },
    { "action": "assert", "label": "The authored vest gives a Hero its own 128 armor plus 4 from agility", "actor": "hero_authored", "metric": "armor", "relative_to": "hero_authored_bare", "equals": 132 }
  ]
}
