{
  "schema": 1,
  "name": "Aura of Experience boosts kill XP but not profession XP (#8605)",
  "contract": "Spell.dbc 818059 Aura of Experience: 'Increases base experience gain from kills and quests by 50% for you and your entire party.' Its MOD_XP_PCT effect carries source mask 63, which includes the profession bit 4, so gathering XP must not change: a level 20 character at mining 1/75 earns the same 190 XP for one orange mining action with the aura as without it: floor(floor(23200 * 0.02 * 0.2 * 2.11 * 1.05) * 0.9295) at the default Rate.XP.Profession 0.2, Rate.XP.Global 0.9295 and dynamic XP 1. The same aura still raises the XP of an equal-level kill above the XP of the character without it.",
  "timeout_ms": 90000,
  "players": [
    { "id": "plain", "race": 1, "class": 22, "level": 20, "melee_hit_rating": 10000, "expertise_rating": 10000 },
    { "id": "boosted", "race": 1, "class": 22, "level": 20, "melee_hit_rating": 10000, "expertise_rating": 10000 }
  ],
  "creatures": [
    { "id": "a", "owner": "plain", "entry": 3098, "level": 20, "health": 1, "distance": 2, "stationary": true },
    { "id": "b", "owner": "boosted", "entry": 3098, "level": 20, "health": 1, "distance": 2, "stationary": true }
  ],
  "steps": [
    { "action": "wait", "label": "Let login hooks settle", "ms": 3000 },
    { "action": "command", "actor": "plain", "command": ".xp 1" },
    { "action": "command", "actor": "boosted", "command": ".xp 1" },
    { "action": "assert", "actor": "plain", "metric": "next_level_xp", "equals": 23200 },
    { "action": "set_aura", "actor": "boosted", "spell": 818059, "stacks": 1 },
    {
      "action": "assert", "label": "the boosted character holds Aura of Experience",
      "actor": "boosted", "metric": "aura", "spell": 818059, "equals": 1, "within_ms": 2000
    },
    { "action": "set_skill", "actor": "plain", "skill": 186, "value": 1, "maximum": 75 },
    { "action": "set_skill", "actor": "boosted", "skill": 186, "value": 1, "maximum": 75 },
    { "action": "snapshot", "actor": "plain", "metric": "xp", "save_as": "plain_mining_before" },
    { "action": "snapshot", "actor": "boosted", "metric": "xp", "save_as": "boosted_mining_before" },
    { "action": "gather_skill", "actor": "plain", "skill": 186, "required": 1 },
    { "action": "gather_skill", "actor": "boosted", "skill": 186, "required": 1 },
    {
      "action": "assert", "label": "orange mining without the aura",
      "actor": "plain", "metric": "xp", "relative_to": "plain_mining_before", "equals": 190
    },
    {
      "action": "assert", "label": "DISCRIMINATING: Aura of Experience leaves orange mining XP unchanged",
      "actor": "boosted", "metric": "xp", "relative_to": "boosted_mining_before", "equals": 190
    },
    { "action": "snapshot", "actor": "plain", "metric": "xp", "save_as": "plain_kill_before" },
    { "action": "snapshot", "actor": "boosted", "metric": "xp", "save_as": "boosted_kill_before" },
    { "action": "attack", "actor": "plain", "target": "a" },
    { "action": "attack", "actor": "boosted", "target": "b" },
    {
      "action": "assert", "label": "plain kill gives XP",
      "actor": "plain", "metric": "xp", "relative_to": "plain_kill_before", "min": 1, "within_ms": 8000
    },
    {
      "action": "assert", "label": "boosted kill gives XP",
      "actor": "boosted", "metric": "xp", "relative_to": "boosted_kill_before", "min": 1, "within_ms": 8000
    },
    { "action": "snapshot", "actor": "plain", "metric": "xp", "save_as": "plain_after_kill" },
    {
      "action": "assert", "label": "Control: Aura of Experience still raises kill XP",
      "actor": "boosted", "metric": "xp", "relative_to": "plain_after_kill", "min": 1
    }
  ]
}
