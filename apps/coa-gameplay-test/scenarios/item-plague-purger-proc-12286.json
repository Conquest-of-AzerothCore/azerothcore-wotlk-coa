      "label": "SETUP: proc dummy 202136 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 202136,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 320726 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 320726,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 202136 loads the record's 12% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 202136,
      "equals": 12
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312726 loads the record's 18% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 312726,
      "equals": 18
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 316726 loads the record's 18% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 316726,
      "equals": 18
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 320726 loads the record's 18% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 320726,
      "equals": 18
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 202136 loads no internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 202136,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312726 loads no internal cooldown",
      "actor": "caster",
