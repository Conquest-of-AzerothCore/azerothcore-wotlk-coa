      "metric": "spell_proc_cooldown_ms",
      "spell": 320726,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: a landed direct magic spell (Frostbolt 116) procs 202136 at 12%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 202136,
      "target": "dummy",
