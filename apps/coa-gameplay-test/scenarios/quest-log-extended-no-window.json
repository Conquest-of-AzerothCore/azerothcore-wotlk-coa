{
  "schema": 1,
  "name": "Quest log: a client that announces 0x8F6 gets no Extra Quests window",
  "contract": [
    "A client that sent HELLO (0x8F6) shows slots 25-63 itself, so with 30 quests (five in overflow slots) the server sends it no COAQLOG addon whispers and no QUEST_LOG_OVERFLOW_WINDOW Lua, neither as a hot patch (0x8F0) nor as a requirement-type formatter (0x5BC)."
  ],
  "timeout_ms": 120000,
  "quest_log_size": 64,
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 20
    }
  ],
  "steps": [
