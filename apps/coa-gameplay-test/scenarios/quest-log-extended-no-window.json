      "action": "wait",
      "label": "Let the fixture settle",
      "ms": 2000
    },
    {
      "action": "client_packet",
      "label": "The client announces the extended quest log (0x8F6, version 1, 64 slots)",
      "actor": "hero",
      "opcode": 2294,
      "fields": [
        {
          "u8": 1
        },
        {
          "u8": 64
        }
      ]
    },
    {
      "action": "assert",
      "label": "The server answers with the 0x8F7 snapshot",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "within_ms": 2000,
      "equals": 1
    },
