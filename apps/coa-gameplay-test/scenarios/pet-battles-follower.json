      "action": "wait",
      "ms": 1000
    },
    {
      "action": "set_phase",
      "label": "followers appear in the normal world phase",
      "actor": "gm",
      "value": 1
    },
    {
      "action": "command",
      "actor": "gm",
      "command": ".petbattle grant 69 5"
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "command",
      "actor": "gm",
      "command": ".petbattle send pbj|summon|69"
    },
    {
      "action": "wait",
      "ms": 3000
    },
    {
      "action": "command",
      "actor": "gm",
      "command": ".petbattle follower"
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "assert",
      "label": "the follower is out",
      "actor": "gm",
      "metric": "system_message_contains",
      "text": "Follower: 69 out",
      "equals": 1
    },
    {
      "action": "command",
      "actor": "gm",
      "command": ".petbattle send pbj|dismiss"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "command",
      "actor": "gm",
      "command": ".petbattle follower"
    },
    {
      "action": "wait",
      "ms": 300
    },
    {
      "action": "assert",
      "label": "dismissed",
      "actor": "gm",
      "metric": "system_message_contains",
      "text": "Follower: none",
      "equals": 1
    },
    {
      "action": "command",
      "actor": "gm",
      "command": ".petbattle send pbj|summon|69"
    },
    {
