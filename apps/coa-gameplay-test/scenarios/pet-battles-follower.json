{
  "schema": 1,
  "name": "Pet battles: a summoned pet follows the character and comes back after a relog",
  "contract": [
    "Phase 5. pbj|summon|69 (an owned Timber Wolf) makes it the follower: it appears within a 2 s tick and is",
    "reported out; pbj|dismiss removes it; a summoned follower is saved (coa_pet_follower) and comes back after",
    "a relog. Followers only show in the normal world phase, so the scenario enters phase 1."
  ],
  "timeout_ms": 120000,
  "vanity_ownership": {
    "unlock_all": false
  },
  "location": {
    "map": 0,
    "x": -8914.0,
    "y": -133.0,
    "z": 80.6
  },
  "players": [
    {
      "id": "gm",
      "race": 1,
      "class": 1,
      "level": 60,
      "security": 2
    }
  ],
  "steps": [
