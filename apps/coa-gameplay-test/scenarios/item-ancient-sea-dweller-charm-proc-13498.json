{
  "schema": 1,
  "name": "Ancient Sea-dweller Charm procs on healing over time effects (#13498)",
  "contract": [
    "#13498: Ancient Sea-dweller Charm (proc dummies 304004, 312973, 316973, 320973) never procced. Every dummy",
    "carries Spell.dbc ProcFlags 0 and the world had no spell_proc row, so SpellMgr::LoadSpellProcs skipped it.",
    "Tooltip: \"Your healing over time effects\", tiers \"(30sec. internal cooldown)\". Flags 262144 (done periodic)",
    "for heals only. spell_proc_chance reads each loaded entry's chance, which equals the record's ProcChance,",
    "and spell_proc_cooldown_ms reads each loaded cooldown. aura_proc_rate replays the aura's native proc",
    "decision, including the roll, 40000 times on one synthetic event per check. It procs on a heal over time",
    "tick (Rejuvenation 774), at the record's chance; it never procs on a direct heal (Flash Heal 2061), a",
    "periodic Shadow tick (Shadow Word: Pain 589). Before the repair the chance and cooldown lookups fail with",
    "'Spell has no proc entry' and every rate reads 0, so the discriminating checks fail instead of flaking."
  ],
  "timeout_ms": 60000,
  "players": [
    {
      "id": "caster",
      "race": 1,
      "class": 1,
      "level": 80,
      "allow_regeneration": false
    }
  ],
  "creatures": [
    {
      "id": "dummy",
      "owner": "caster",
      "entry": 36,
      "level": 80,
      "health": 1000000,
      "distance": 4
    }
  ],
  "steps": [
    {
      "action": "wait",
      "label": "Let spawn AI and level scaling settle",
      "ms": 5000
    },
    {
      "action": "set_aura",
      "label": "Proc dummy 304004",
      "actor": "caster",
      "spell": 304004,
      "stacks": 1
    },
    {
      "action": "set_aura",
      "label": "Proc dummy 320973",
      "actor": "caster",
      "spell": 320973,
      "stacks": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 304004 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 304004,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "SETUP: proc dummy 320973 is applied",
      "actor": "caster",
      "metric": "aura",
      "spell": 320973,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 304004 loads the record's 6% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 304004,
      "equals": 6
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312973 loads the record's 6% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 312973,
      "equals": 6
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 316973 loads the record's 6% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 316973,
      "equals": 6
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 320973 loads the record's 6% chance",
      "actor": "caster",
      "metric": "spell_proc_chance",
      "spell": 320973,
      "equals": 6
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 304004 loads no internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 304004,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 312973 loads the tooltip's 30 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 312973,
      "equals": 30000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 316973 loads the tooltip's 30 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 316973,
      "equals": 30000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: 320973 loads the tooltip's 30 s internal cooldown",
      "actor": "caster",
      "metric": "spell_proc_cooldown_ms",
      "spell": 320973,
      "equals": 30000
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: a heal over time tick (Rejuvenation 774) procs 304004 at 6%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 304004,
      "target": "caster",
      "heal": true,
      "trigger_spell": 774,
      "type_mask": 262144,
      "phase_mask": 2,
      "spell_type_mask": 2,
      "hit_mask": 1,
      "min": 4.5,
      "max": 7.5
    },
    {
      "action": "assert",
      "label": "DISCRIMINATING: a heal over time tick (Rejuvenation 774) procs 320973 at 6%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 320973,
      "target": "caster",
      "heal": true,
      "trigger_spell": 774,
      "type_mask": 262144,
      "phase_mask": 2,
      "spell_type_mask": 2,
      "hit_mask": 1,
      "min": 4.5,
      "max": 7.5
    },
    {
      "action": "assert",
      "label": "CONTROL: a direct heal (Flash Heal 2061) procs 304004 at 0%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 304004,
      "target": "caster",
      "heal": true,
      "trigger_spell": 2061,
      "type_mask": 16384,
      "phase_mask": 2,
      "spell_type_mask": 2,
      "hit_mask": 1,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "CONTROL: a periodic Shadow tick (Shadow Word: Pain 589) procs 304004 at 0%",
      "actor": "caster",
      "metric": "aura_proc_rate",
      "spell": 304004,
      "target": "dummy",
      "trigger_spell": 589,
      "type_mask": 262144,
      "phase_mask": 2,
      "spell_type_mask": 1,
      "hit_mask": 1,
      "equals": 0
    }
  ]
}
