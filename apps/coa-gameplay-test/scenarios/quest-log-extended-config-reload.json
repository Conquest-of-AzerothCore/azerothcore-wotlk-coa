{
  "schema": 1,
  "name": "Quest log: a config reload that changes Quests.LogSize resends the 0x8F7 snapshot",
  "contract": [
    "Quests.LogSize is reloadable. When .reload config changes it, every client that sent HELLO (0x8F6) gets a full 0x8F7 snapshot with the new log size on its next update.",
    "The scenario starts at 64; the harness worldserver.conf leaves Quests.LogSize at its default 25, so the reload drops the size to 25 while the five overflow quests in slots 25-29 are still listed."
  ],
  "timeout_ms": 120000,
  "quest_log_size": 64,
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 20
    }
  ],
