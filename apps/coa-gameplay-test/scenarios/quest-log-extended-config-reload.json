      "action": "assert",
      "label": "The server answers with the 0x8F7 snapshot",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "within_ms": 2000,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "SETUP: the snapshot log size is 64",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 2,
      "equals": 64
    },
    {
      "action": "console",
      "label": "Reload the config, which sets Quests.LogSize back to 25",
      "command": "reload config"
    },
    {
      "action": "assert",
      "label": "The reload sends a second 0x8F7",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "within_ms": 2000,
      "equals": 2
    },
    {
      "action": "assert",
      "label": "It is a full snapshot",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 1,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "It carries the new log size 25",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 2,
      "equals": 25
    },
    {
      "action": "assert",
      "label": "It still lists the five overflow quests",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 3,
      "equals": 5
    },
    {
      "action": "wait",
      "label": "Let further ticks pass",
      "ms": 1000
    },
    {
      "action": "assert",
      "label": "An unchanged size sends nothing more",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "equals": 2
    }
