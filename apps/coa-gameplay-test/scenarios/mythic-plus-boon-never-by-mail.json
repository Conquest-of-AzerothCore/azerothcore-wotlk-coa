{
  "schema": 1,
  "name": "Mythical Boon: a player with full bags gets no boon item, not even by mail",
  "contract": [
    "Boon items work only inside a running keystone and vanish when their owner leaves the dungeon. Our tester asked",
    "that they never go out by mail. A player whose bags are full when a Mythical Boon (80215) is picked up gets none."
  ],
  "timeout_ms": 120000,
  "location": {
    "map": 0,
    "x": -8914.0,
    "y": -133.0,
    "z": 80.6
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "ally",
      "race": 1,
      "class": 1,
      "level": 60
    }
  ],
  "steps": [
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "set_health",
      "actor": "hero",
      "value": 5000000,
      "maximum": 5000000
    },
    {
      "action": "set_health",
      "actor": "ally",
      "value": 5000000,
      "maximum": 5000000
    },
    {
      "action": "group",
      "actor": "hero",
      "target": "ally"
    },
    {
      "action": "ascension_dungeon_difficulty_packet",
      "actor": "hero",
      "value": 2
    },
    {
      "action": "wait",
      "ms": 250
    },
    {
      "action": "teleport",
      "actor": "hero",
      "map": 189,
      "x": 1630.3,
      "y": -333.9,
      "z": 18.6
    },
    {
      "action": "teleport",
      "actor": "ally",
      "map": 189,
      "x": 1630.3,
      "y": -333.9,
      "z": 18.6
    },
    {
      "action": "wait",
      "ms": 1500
    },
    {
      "action": "assert",
      "label": "CONTROL: the ally is in the Mythic Armory",
      "actor": "ally",
      "metric": "map_difficulty",
      "equals": 2
    },
    {
      "action": "add_item",
      "actor": "hero",
      "item": 1233152,
      "count": 1
    },
    {
      "action": "use_item",
      "actor": "hero",
      "item": 1233152,
      "spell": 161
    },
    {
      "action": "assert",
      "label": "CONTROL: socket window",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2310,
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "client_packet",
      "actor": "hero",
      "opcode": 1319
    },
    {
      "action": "assert",
      "label": "CONTROL: Start Keystone starts the countdown",
      "actor": "ally",
      "metric": "rooted",
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "wait",
      "ms": 10500
    },
    {
      "action": "assert",
      "label": "CONTROL: the run is under way",
      "actor": "hero",
      "metric": "rooted",
      "equals": 0,
      "within_ms": 2000
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "fill_bags",
      "actor": "ally"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "fill_bags",
      "label": "Refill a slot freed by a filler item that vanished",
      "actor": "ally"
    },
    {
      "action": "assert",
      "label": "CONTROL: the ally's bags are full",
      "actor": "ally",
      "metric": "free_inventory_slots",
      "equals": 0
    },
    {
      "action": "snapshot",
      "actor": "ally",
      "metric": "mail_count",
      "save_as": "ally_mails"
    },
    {
      "action": "summon",
      "actor": "hero",
      "entry": 80215,
      "as": "boon",
      "distance": 3
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "gossip_hello",
      "actor": "hero",
      "target": "boon"
    },
    {
      "action": "assert",
      "label": "CONTROL: the clicker gets a boon item",
      "actor": "hero",
      "metric": "item_count",
      "items": [
        2104920,
        2104921,
        2104922,
        2104923,
        2104925,
        2104926,
        2104927,
        2104928,
        2104929,
        2104930,
        2104931,
        2104932,
        2104935
      ],
      "equals": 1,
      "within_ms": 1000
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "assert",
      "label": "the ally with full bags gets no boon item by mail",
      "actor": "ally",
      "metric": "mail_count",
      "relative_to": "ally_mails",
      "equals": 0
    },
    {
      "action": "assert",
      "label": "and carries none",
      "actor": "ally",
      "metric": "item_count",
      "items": [
        2104920,
        2104921,
        2104922,
        2104923,
        2104925,
        2104926,
        2104927,
        2104928,
        2104929,
        2104930,
        2104931,
        2104932,
        2104935
      ],
      "equals": 0
    }
  ]
}
