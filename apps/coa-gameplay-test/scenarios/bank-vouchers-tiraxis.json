    { "action": "assert", "label": "Exactly one voucher is consumed", "actor": "master", "metric": "item_count", "item": 102131, "equals": 7 },

    { "action": "use_item", "actor": "master", "item": 102131, "spell": 56685 },
    { "action": "wait", "ms": 1000 },
    { "action": "use_item", "actor": "master", "item": 102131, "spell": 56685 },
