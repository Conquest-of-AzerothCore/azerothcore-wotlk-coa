    { "action": "assert", "label": "Two vouchers are left", "actor": "master", "metric": "item_count", "item": 102131, "equals": 2 },

    { "action": "use_item", "actor": "master", "item": 102131, "spell": 56685 },
    { "action": "wait", "ms": 1000 },
    { "action": "assert", "label": "A full guild vault keeps its voucher", "actor": "master", "metric": "item_count", "item": 102131, "equals": 2 },
    { "action": "assert", "actor": "master", "metric": "guild_bank_tabs", "equals": 6 },

    { "action": "console", "command": "guild invite Harnessb \"Harness Vault\"" },
