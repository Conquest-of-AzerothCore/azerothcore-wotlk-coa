{
  "schema": 1,
  "name": "Barbarian: Outrage 801759 haste ends when the Barbarian dies to a creature (#12326)",
  "contract": [
    "Outrage raises melee haste by 20% (aura 192) for its duration. Dying removes the aura, so after a revive",
    "the main-hand swing time is back to its baseline. The report: dying to a creature while Outrage is active",
    "left the attack speed bonus in place permanently. A death by self damage is checked first as a control."
  ],
  "timeout_ms": 120000,
  "players": [
    { "id": "b", "race": 1, "class": 12, "level": 60, "allow_regeneration": false }
  ],
  "creatures": [
    { "id": "d", "owner": "b", "entry": 36, "level": 63, "health": 5000000, "distance": 3, "reaction": 2 }
  ],
  "steps": [
    { "action": "wait", "ms": 3000 },
    { "action": "add_item", "actor": "b", "item": 25 },
    { "action": "equip", "actor": "b", "item": 25, "slot": 15 },
    { "action": "wait", "ms": 1000 },
    { "action": "snapshot", "label": "Baseline main-hand swing time", "actor": "b", "metric": "attack_time_ms",
      "hand": 0, "save_as": "swing0" },

    { "action": "set_aura", "actor": "b", "spell": 801759, "stacks": 1 },
    { "action": "assert", "label": "SETUP: Outrage is on the Barbarian", "actor": "b", "metric": "aura",
      "spell": 801759, "equals": 1, "within_ms": 2000 },
    { "action": "assert", "label": "Outrage makes swings 20% faster", "actor": "b", "metric": "attack_time_ms",
      "hand": 0, "ratio_to": "swing0", "min": 0.82, "max": 0.85 },
    { "action": "die", "label": "Control: the Barbarian dies to self damage with Outrage active", "actor": "b" },
    { "action": "console", "command": "revive Harnessa" },
    { "action": "assert", "label": "SETUP: the Barbarian is revived", "actor": "b", "metric": "alive", "equals": 1,
      "within_ms": 3000 },
    { "action": "assert", "label": "Control: the self-damage death removed Outrage", "actor": "b",
      "metric": "aura", "spell": 801759, "equals": 0 },
    { "action": "assert", "label": "Control: swing time is back to baseline", "actor": "b",
      "metric": "attack_time_ms", "hand": 0, "ratio_to": "swing0", "min": 0.99, "max": 1.01 },

    { "action": "learn", "actor": "b", "spell": 801759 },
    { "action": "set_aura", "actor": "b", "spell": 801761, "stacks": 1 },
    { "action": "attack", "actor": "b", "target": "d" },
    { "action": "cast", "actor": "b", "spell": 801759 },
    { "action": "assert", "label": "SETUP: the cast Outrage is on the Barbarian", "actor": "b", "metric": "aura",
      "spell": 801759, "equals": 1, "within_ms": 2000 },
    { "action": "snapshot", "label": "Swing time with the cast Outrage", "actor": "b", "metric": "attack_time_ms",
      "hand": 0, "save_as": "swing_outrage" },
    { "action": "wait", "ms": 4000 },
    { "action": "set_health", "actor": "b", "value": 1 },
    { "action": "assert", "label": "The creature kills the Barbarian while Outrage is active", "actor": "b",
      "metric": "alive", "equals": 0, "within_ms": 20000 },
    { "action": "assert", "label": "The death removed Outrage", "actor": "b", "metric": "aura", "spell": 801759,
      "equals": 0 },
    { "action": "snapshot", "label": "Swing time on the corpse", "actor": "b", "metric": "attack_time_ms",
      "hand": 0, "save_as": "swing_dead" },
    { "action": "release_spirit", "actor": "b" },
    { "action": "console", "command": "revive Harnessa" },
    { "action": "assert", "label": "SETUP: the Barbarian is revived again", "actor": "b", "metric": "alive",
      "equals": 1, "within_ms": 3000 },
    { "action": "assert", "label": "Swing time is back to baseline after dying to a creature", "actor": "b",
      "metric": "attack_time_ms", "hand": 0, "ratio_to": "swing0", "min": 0.99, "max": 1.01 },

    { "action": "teleport", "actor": "b", "map": 36, "x": -16.4, "y": -383.07, "z": 61.78 },
    { "action": "assert", "label": "SETUP: the Barbarian is in Deadmines", "actor": "b", "metric": "map_id",
      "equals": 36, "within_ms": 15000 },
    { "action": "wait", "ms": 1000 },
    { "action": "reset_cooldown", "actor": "b", "spell": 801759 },
    { "action": "set_aura", "actor": "b", "spell": 801761, "stacks": 1 },
    { "action": "summon", "actor": "b", "as": "pirate", "entry": 657, "distance": 3 },
    { "action": "attack", "actor": "b", "target": "pirate" },
    { "action": "cast", "actor": "b", "spell": 801759 },
    { "action": "assert", "label": "SETUP: Outrage is on the Barbarian in the dungeon", "actor": "b",
      "metric": "aura", "spell": 801759, "equals": 1, "within_ms": 2000 },
    { "action": "wait", "ms": 4000 },
    { "action": "set_health", "actor": "b", "value": 1 },
    { "action": "assert", "label": "The pirate kills the Barbarian while Outrage is active", "actor": "b",
      "metric": "alive", "equals": 0, "within_ms": 20000 },
    { "action": "snapshot", "label": "Swing time on the dungeon corpse", "actor": "b", "metric": "attack_time_ms",
      "hand": 0, "save_as": "swing_dungeon_dead" },
    { "action": "release_spirit", "actor": "b" },
    { "action": "assert", "label": "SETUP: the dungeon release revives the Barbarian", "actor": "b",
      "metric": "alive", "equals": 1, "within_ms": 5000 },
    { "action": "assert", "label": "Swing time is back to baseline after the dungeon release", "actor": "b",
      "metric": "attack_time_ms", "hand": 0, "ratio_to": "swing0", "min": 0.99, "max": 1.01 }
  ]
}
