{
  "schema": 1,
  "name": "Zul'Gurub: every Cache of the Blood God opens into one of Hakkar's own items, never the Heart",
  "contract": [
    "Hakkar's Cache of the Blood God (Normal 1400023, Heroic 1400039, Mythic 2400039, Ascended 2500039) gives",
    "everyone one of Hakkar's own items for its tier; it never holds the Heart of Hakkar, a one-per-run world buff",
    "item (tester, live, 2026-11-04). Before, none of the four had loot, so they could not be opened. Each hero",
    "opens one cache, two by using it and two through the open packet: the cache is used up and exactly one item",
    "of its loot is in the bags."
  ],
  "timeout_ms": 60000,
  "location": {
    "map": 0,
    "x": -8914.0,
    "y": -133.0,
    "z": 80.6
  },
  "players": [
    {
      "id": "normal",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "heroic",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "mythic",
      "race": 1,
      "class": 1,
      "level": 60
    },
    {
      "id": "ascended",
      "race": 1,
      "class": 1,
      "level": 60
    }
  ],
  "steps": [
