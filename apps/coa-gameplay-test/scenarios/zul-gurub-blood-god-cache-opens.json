      "item": 2500039
    },
    {
      "action": "assert",
      "label": "The Normal cache is used up",
      "actor": "normal",
      "metric": "item_count",
      "item": 1400023,
      "equals": 0,
      "within_ms": 3000
    },
    {
      "action": "assert",
      "label": "It gave one of Hakkar's Normal items",
      "actor": "normal",
      "metric": "carried_pool_item_count",
      "cache": 1400023,
      "table": "loot",
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The Heroic cache is used up",
      "actor": "heroic",
