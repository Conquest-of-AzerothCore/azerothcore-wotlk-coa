      "item": 1400039,
      "count": 1
    },
    {
      "action": "add_item",
      "actor": "mythic",
      "item": 2400039,
      "count": 1
    },
    {
      "action": "add_item",
      "actor": "ascended",
      "item": 2500039,
      "count": 1
    },
    {
      "action": "assert",
