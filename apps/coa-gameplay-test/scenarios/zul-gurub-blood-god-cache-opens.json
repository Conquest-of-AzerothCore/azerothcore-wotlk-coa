      "within_ms": 3000
    },
    {
      "action": "assert",
      "label": "It gave one of Hakkar's Heroic items",
      "actor": "heroic",
      "metric": "carried_pool_item_count",
      "cache": 1400039,
      "table": "loot",
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The Mythic cache is used up",
      "actor": "mythic",
      "metric": "item_count",
      "item": 2400039,
      "equals": 0,
      "within_ms": 3000
    },
    {
      "action": "assert",
      "label": "It gave one of Hakkar's Mythic items",
      "actor": "mythic",
      "metric": "carried_pool_item_count",
      "cache": 2400039,
      "table": "loot",
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The Ascended cache is used up",
