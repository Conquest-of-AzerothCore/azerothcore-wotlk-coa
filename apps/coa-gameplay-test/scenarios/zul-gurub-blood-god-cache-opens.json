      "actor": "normal",
      "metric": "item_count",
      "item": 1400023,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "CONTROL: the Normal hero holds none of its items yet",
      "actor": "normal",
      "metric": "carried_pool_item_count",
      "cache": 1400023,
      "table": "loot",
      "equals": 0
    },
    {
      "action": "use_item",
      "label": "Use the Normal cache",
      "actor": "normal",
      "item": 1400023,
      "spell": 93461
    },
    {
      "action": "use_item",
      "label": "Use the Heroic cache",
      "actor": "heroic",
      "item": 1400039,
      "spell": 93461
    },
    {
      "action": "open_item",
      "label": "Open the Mythic cache",
      "actor": "mythic",
      "item": 2400039
