    { "action": "cast", "actor": "hero", "spell": 2094, "target": "hero_dummy" },
    { "action": "cast", "actor": "druid", "spell": 2094, "target": "druid_dummy" },
    { "action": "assert", "label": "The Hero casts Blind in Cat Form", "actor": "hero", "metric": "cast_failure",
      "spell": 2094, "equals": 0, "within_ms": 1000 },
    { "action": "assert", "label": "and stays in Cat Form", "actor": "hero", "metric": "aura", "spell": 768,
      "equals": 1 },
    { "action": "assert", "label": "A stock Druid is still refused Blind in Cat Form", "actor": "druid",
      "metric": "cast_failure", "spell": 2094, "equals": 68, "within_ms": 1000 },
    { "action": "wait", "label": "Clear the global cooldown", "ms": 1600 },
    { "action": "cast", "actor": "hero", "spell": 8936, "target": "hero" },
    { "action": "assert", "label": "Regrowth still needs the Hero out of Cat Form", "actor": "hero",
