    { "action": "learn", "actor": "hero", "spell": 768 },
    { "action": "learn", "actor": "hero", "spell": 2094 },
    { "action": "learn", "actor": "hero", "spell": 8936 },
    { "action": "learn", "actor": "druid", "spell": 768 },
    { "action": "learn", "actor": "druid", "spell": 2094 },
    { "action": "cast", "actor": "hero", "spell": 768 },
    { "action": "cast", "actor": "druid", "spell": 768 },
    { "action": "assert", "label": "The Hero is in Cat Form", "actor": "hero", "metric": "aura", "spell": 768,
      "equals": 1, "within_ms": 3000 },
    { "action": "assert", "label": "The Hero has the Rogue ability aura", "actor": "hero", "metric": "aura",
      "spell": 9726363, "equals": 1 },
    { "action": "assert", "label": "and the Warrior ability aura", "actor": "hero", "metric": "aura", "spell": 9726361,
      "equals": 1 },
    { "action": "assert", "label": "The Druid is in Cat Form", "actor": "druid", "metric": "aura", "spell": 768,
      "equals": 1 },
    { "action": "assert", "label": "A stock Druid gets no ability aura", "actor": "druid", "metric": "aura",
      "spell": 9726363, "equals": 0 },
    { "action": "wait", "label": "Clear the global cooldown", "ms": 1600 },
    { "action": "set_power", "actor": "hero", "power": 3, "value": 100 },
