{
  "schema": 1,
  "name": "Centurion Strike with a two-handed sword triggers its sword effect (#10014)",
  "contract": [
    "Centurion Strike 802738's sword line reads 'Triggers 807967 additional auto attacks'. With a two-handed",
    "sword in the main hand the cast must produce one 802738 damage event on the main target, none on the",
    "enemy behind it, and cast the extra-attacks spell 807967 once, so a polearm-only extra stab stays",
    "weapon-specific. Fixture: guardian level 80 on the default location facing the spawn axis, Bloodvenom",
    "Blade 50672 (one-handed sword, the class's sword proficiency) in the main hand, hostiles at distance 2",
    "(front) and 5 (back)."
  ],
  "timeout_ms": 90000,
  "players": [
    {
      "id": "guardian",
      "race": 1,
      "class": 18,
      "level": 80,
      "melee_hit_rating": 10000,
      "expertise_rating": 10000,
      "spell_hit_rating": 10000
    }
  ],
  "creatures": [
    {
      "id": "front",
      "owner": "guardian",
      "entry": 36,
      "faction": 14,
      "level": 80,
      "health": 1000000,
      "distance": 2
    },
    {
      "id": "back",
      "owner": "guardian",
      "entry": 36,
      "faction": 14,
      "level": 80,
      "health": 1000000,
      "distance": 5
    }
  ],
  "steps": [
    { "action": "wait", "label": "Let spawn AI and level scaling settle", "ms": 5000 },
    { "action": "learn", "actor": "guardian", "spell": 802738 },
    { "action": "set_skill", "actor": "guardian", "skill": 43, "value": 400, "maximum": 400 },
    { "action": "add_item", "actor": "guardian", "item": 50672 },
    { "action": "equip", "actor": "guardian", "item": 50672, "slot": 15 },
    {
      "action": "assert", "label": "SETUP: the one-handed sword is in the main hand", "actor": "guardian",
      "metric": "equipped_item", "slot": 15, "equals": 50672
    },
    { "action": "set_power", "actor": "guardian", "power": 3, "value": 100 },
    { "action": "reset_cooldown", "actor": "guardian", "spell": 802738 },
    { "action": "wait", "label": "Let the global cooldown pass", "ms": 1700 },
    {
      "action": "snapshot", "label": "802738 damage logs on the main target before the cast",
      "actor": "guardian", "metric": "spell_damage_count", "spell": 802738, "target": "front",
      "save_as": "front_before"
    },
    {
      "action": "snapshot", "label": "802738 damage logs behind the target before the cast",
      "actor": "guardian", "metric": "spell_damage_count", "spell": 802738, "target": "back",
      "save_as": "back_before"
    },
    {
      "action": "snapshot", "label": "807967 casts before the cast", "actor": "guardian",
      "metric": "spell_cast_count", "spell": 807967, "save_as": "sword_casts_before"
    },
    {
      "action": "cast", "label": "Centurion Strike with a two-handed sword", "actor": "guardian",
      "spell": 802738, "target": "front"
    },
    {
      "action": "assert", "label": "the sword lands a single stab on the main target",
      "actor": "guardian", "metric": "spell_damage_count", "spell": 802738, "target": "front",
      "relative_to": "front_before", "equals": 1, "within_ms": 4000
    },
    {
      "action": "assert", "label": "the sword reaches nothing behind the main target",
      "actor": "guardian", "metric": "spell_damage_count", "spell": 802738, "target": "back",
      "relative_to": "back_before", "equals": 0
    },
    {
      "action": "assert", "label": "DISCRIMINATING: the sword casts the extra attacks 807967",
      "actor": "guardian", "metric": "spell_cast_count", "spell": 807967,
      "relative_to": "sword_casts_before", "equals": 1, "within_ms": 4000
    }
  ]
}
