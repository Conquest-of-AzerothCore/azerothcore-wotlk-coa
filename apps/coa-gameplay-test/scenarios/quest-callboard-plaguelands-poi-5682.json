{
  "schema": 1,
  "name": "Hero's Call Board Plaguelands quests show their objective areas on the world map (#5682)",
  "contract": "The PvE Call Board quests had no quest_poi rows, so CMSG_QUEST_POI_QUERY (0x1E3) answered SMSG_QUEST_POI_QUERY_RESPONSE (0x1E4) with quest id 0 and no POIs, and the client drew nothing. Each creature objective now has one POI per spawn cluster of its NPC. Expected: Plague's Predatory Pests 18030 answers with 16 POIs on map 0, Eastern Plaguelands world map area 23 (client WorldMapArea.dbc); Echoes of Despair 18054 answers with 3 POIs on Western Plaguelands area 22. Objective NPCs that spawn only as an extra entry of a multi-entry spawn (creature_multispawn) are marked too: Winterfall Purge 17926 answers with 4 POIs on Winterspring area 281 (2 Winterfall Pathfinder 7442 clusters, 2 Winterfall Totemic 7441 clusters) and Demon Dispersal 18019 with 3 on Felwood area 182 (one per objective, Jadefire Betrayer 7108 included). Map rendering itself is not observed.",
  "timeout_ms": 30000,
  "location": { "map": 0, "x": 2314.55, "y": -5322.86, "z": 82.05, "o": 0 },
  "players": [
    { "id": "hero", "race": 1, "class": 1, "level": 60 }
  ],
  "steps": [
    { "action": "wait", "label": "Let login settle", "ms": 3000 },
    { "action": "prepare_quest", "label": "Take Plague's Predatory Pests", "actor": "hero", "quest": 18030, "complete": false },
    {
      "action": "client_packet", "label": "Query the 18030 map POIs", "actor": "hero", "opcode": 483, "consumed": false,
      "fields": [{ "u32": 1 }, { "u32": 18030 }]
    },
    {
      "action": "assert", "label": "The POI response names quest 18030", "actor": "hero",
      "metric": "server_packet_u32", "opcode": 484, "row": 1, "index": 1, "equals": 18030, "within_ms": 3000
    },
    {
      "action": "assert", "label": "Every 18030 spawn cluster is marked", "actor": "hero",
      "metric": "server_packet_u32", "opcode": 484, "row": 1, "index": 2, "equals": 16, "within_ms": 3000
    },
    {
