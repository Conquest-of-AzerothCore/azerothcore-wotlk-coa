      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "equals": 2
    },
    {
      "action": "assert",
      "label": "Quest 318 moved into client slot 3",
      "actor": "hero",
      "metric": "quest_log_client_slot",
      "quest": 318,
      "equals": 3
    },
