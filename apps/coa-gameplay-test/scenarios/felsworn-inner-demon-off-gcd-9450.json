    "starts the 1000 ms Felsworn global cooldown (category 133). Casting Inner Demon must not start that cooldown,",
    "and Inner Demon must cast while Smite's global cooldown is still running."
  ],
  "timeout_ms": 90000,
  "players": [
    { "id": "f", "race": 1, "class": 14, "level": 44, "spell_hit_rating": 10000, "allow_regeneration": false }
  ],
  "creatures": [
    { "id": "e", "owner": "f", "entry": 36, "level": 44, "health": 1000000, "distance": 3 }
  ],
  "steps": [
