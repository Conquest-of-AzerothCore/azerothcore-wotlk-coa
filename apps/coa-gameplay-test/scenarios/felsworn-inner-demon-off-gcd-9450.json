    { "action": "learn", "actor": "f", "spell": 804216 },
    { "action": "set_power", "actor": "f", "power": 3, "value": 100 },
    { "action": "set_aura", "label": "FIXTURE: one Felfury for a 5 s Inner Demon", "actor": "f", "spell": 800058, "stacks": 1 },
