{
  "schema": 1,
  "name": "Heroic and Mythic Obsidian Sentinel leave one dungeon item of their difficulty on the corpse (#11634)",
  "contract": [
    "#11634: Obsidian Sentinel in Uldaman dropped no boss item on Heroic. Its Heroic (107023) and Mythic (207023)",
    "templates used the Normal loot list 7023, so a kill left stones, a quest item and at most a green from the",
    "guaranteed gear roll. On Ascension each Heroic and Mythic kill also left one random dungeon item of that",
    "difficulty (db.exil.es archive: 893 Heroic and 887 Mythic items at about 0.11 % each). Each corpse now rolls",
    "the Heroic (1202039, item level 61) or Mythic (1027965, item level 64) dungeon item pool once."
  ],
  "timeout_ms": 120000,
  "location": {"map": 0, "x": -8914.0, "y": -133.0, "z": 80.6},
  "players": [
    {"id": "hero", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000},
    {"id": "myth", "race": 1, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000}
  ],
  "steps": [
    {"action": "wait", "ms": 1000},
    {"action": "assert", "label": "Heroic Sentinel's loot list holds a rare or better item in nearly every fill",
     "actor": "hero", "metric": "creature_loot_quality_rate", "entry": 107023, "min": 95, "max": 100},
    {"action": "assert", "label": "Mythic Sentinel's loot list holds a rare or better item in nearly every fill",
     "actor": "hero", "metric": "creature_loot_quality_rate", "entry": 207023, "min": 95, "max": 100},
    {"action": "set_health", "actor": "hero", "value": 5000000, "maximum": 5000000},
    {"action": "set_health", "actor": "myth", "value": 5000000, "maximum": 5000000},
    {"action": "ascension_dungeon_difficulty_packet", "actor": "hero", "value": 1},
    {"action": "ascension_dungeon_difficulty_packet", "actor": "myth", "value": 2},
    {"action": "wait", "ms": 500},
    {"action": "teleport", "actor": "hero", "map": 70, "x": -150.0, "y": 385.0, "z": -37.0, "ignore_access": true},
    {"action": "teleport", "actor": "myth", "map": 70, "x": -150.0, "y": 385.0, "z": -37.0, "ignore_access": true},
    {"action": "assert", "label": "CONTROL: hero is in Uldaman on Heroic", "actor": "hero", "metric": "map_difficulty",
     "equals": 1, "within_ms": 15000},
    {"action": "assert", "label": "CONTROL: myth is in Uldaman on Mythic", "actor": "myth", "metric": "map_difficulty",
     "equals": 2, "within_ms": 15000},
    {"action": "wait", "ms": 1500},
    {"action": "summon", "actor": "hero", "entry": 7023, "as": "heroic_sentinel", "distance": 4},
    {"action": "wait", "ms": 300},
    {"action": "assert", "label": "CONTROL: the Sentinel's Heroic template", "actor": "hero",
     "metric": "nearby_creature_template", "entry": 7023, "equals": 107023},
    {"action": "attack_nearby", "actor": "hero", "entry": 7023, "kill": true},
    {"action": "assert", "actor": "heroic_sentinel", "metric": "alive", "equals": 0, "within_ms": 10000},
    {"action": "loot_creature", "actor": "hero", "target": "heroic_sentinel"},
    {"action": "assert", "label": "One epic item on the Heroic corpse", "actor": "hero", "metric": "loot_count",
     "quality": 4, "equals": 1},
    {"action": "assert", "label": "DISCRIMINATING: it is a Heroic dungeon item (item level 61)", "actor": "hero",
     "metric": "loot_gear_item_level", "min": 61, "max": 61},
    {"action": "close_loot", "actor": "hero"},
    {"action": "summon", "actor": "myth", "entry": 7023, "as": "mythic_sentinel", "distance": 4},
    {"action": "wait", "ms": 300},
    {"action": "assert", "label": "CONTROL: the Sentinel's Mythic template", "actor": "myth",
     "metric": "nearby_creature_template", "entry": 7023, "equals": 207023},
    {"action": "attack_nearby", "actor": "myth", "entry": 7023, "kill": true},
    {"action": "assert", "actor": "mythic_sentinel", "metric": "alive", "equals": 0, "within_ms": 10000},
    {"action": "loot_creature", "actor": "myth", "target": "mythic_sentinel"},
    {"action": "assert", "label": "One epic item on the Mythic corpse", "actor": "myth", "metric": "loot_count",
     "quality": 4, "equals": 1},
    {"action": "assert", "label": "DISCRIMINATING: it is a Mythic dungeon item (item level 64)", "actor": "myth",
     "metric": "loot_gear_item_level", "min": 64, "max": 64},
    {"action": "close_loot", "actor": "myth"}
  ]
}
