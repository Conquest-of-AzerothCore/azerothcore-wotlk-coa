{
  "schema": 1,
  "name": "Path to Ascension: Wildcard skill cards, locks, scroll rerolls, packs, Silas' scrolls and rapid rolling verify their tutorials",
  "contract": "Tutorial.dbc names nine Wildcard tutorials, each requiring game mode 0x40 (Wildcard), whose objectives the server performs: 100 'Activate a Skill Card at level 1-9.', 96 'Lock a Spell or Talent from being rerolled in Character Advancement.', 94 'Reroll a Spell with a Scroll of Fortune.', 95 'Reroll a Talent with a Scroll of Fortune.', 97 'Open a Sealed Card Pack.', 98 for the Golden Ability Sealed Card Pack (778998), 238 'Claim Scrolls of Fortune from Silas Darkmoon.', 240 'Repurchase Scrolls of Fortune from Silas.' and 242 'Use Rapid Rerolling.'. The client sends a starter card with CMSG 0x622 (SMSG 0x623), a lock with CMSG 0x658 (SMSG 0x659), a scroll reroll with CMSG 0x61D (SMSG 0x61E), a pack with CMSG 0x66A or by using the pack item (SMSG 0x66B), Silas' claim with CMSG 0x6B5 (SMSG 0x6B6), a repurchase with CMSG 0x6F1 (SMSG 0x6F4) and a rapid roll with CMSG 0x643 carrying a roll count (SMSG 0x644). Expected: each accepted action verifies its tutorial for a Wildcard Hero; a starter card set at level 10 does not verify 100; an ordinary Ability pack verifies 97 but not 98, a golden one both; a spell reroll verifies 94 but not 95 and a talent reroll 95 but not 94; a Hero outside Wildcard is refused each action and verifies none of the nine.",
  "timeout_ms": 240000,
  "location": { "map": 0, "x": -8816.5, "y": 627.0, "z": 94.1, "o": 3.8 },
  "players": [
    { "id": "wild", "race": 1, "class": 10, "level": 1 },
