    {
      "action": "assert",
      "label": "REFUSED: quest 14 stays in slot 3, so slot 3 cannot be refilled past the log size",
      "actor": "hero",
      "metric": "quest_log_slot",
      "quest": 14,
      "equals": 3
    },
    {
      "action": "assert",
      "label": "The log is still full at 30",
      "actor": "hero",
      "metric": "quest_log_has_room",
      "equals": 0
