      "actor": "hero",
      "opcode": 403,
      "fields": [
        {
          "u8": 3
        },
        {
          "u8": 50
        }
      ],
      "consumed": false
    },
    {
      "action": "wait",
      "label": "Let the swap and any promotion be handled",
      "ms": 1000
