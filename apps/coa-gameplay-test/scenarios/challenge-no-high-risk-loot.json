{
  "schema": 1,
  "name": "A challenge with NO_HIGH_RISK_LOOT cannot loot another player's High-Risk chest",
  "contract": [
    "ChallengeRuleTypes 53 NO_HIGH_RISK_LOOT reads \"You are unable to loot the spoils of slain players in High-Risk\"; 36 challenges carry it (Ironman group 2, Prestige Ironman group 53, 158, 190, 404), but no code enforced it.",
    "Expected: opening a High-Risk chest (994300) owned by another character asks HighRisk::CanLoot; the challenge guard refuses it while the rule is active and tells the player why.",
    "Control: a High-Risk character outside any challenge opens the same chest.",
    "The rule covers the spoils of other players only: the dead owner, in the same challenge, still recovers their own chest after revival.",
    "Just for the Fun of It (158) carries only this rule. Requires HighRisk.Losses = 1 and HighRisk.GearChance, HighRisk.ResourceChance and HighRisk.GoldChance = 100 in coa.conf."
  ],
  "players": [
    { "id": "v", "race": 1, "class": 1, "level": 60 },
    { "id": "k", "race": 2, "class": 1, "level": 60, "melee_hit_rating": 10000, "expertise_rating": 10000 },
    { "id": "o", "race": 1, "class": 1, "level": 60 }
  ],
  "location": { "map": 0, "x": -9617.06, "y": -288.949, "z": 57.3053, "o": 0 },
  "timeout_ms": 150000,
  "steps": [
    { "action": "teleport", "actor": "k", "map": 0, "x": -9614.06, "y": -288.949, "z": 57.3053, "o": 3.14159 },
    { "action": "teleport", "actor": "o", "map": 0, "x": -9615.06, "y": -288.949, "z": 57.3053, "o": 3.14159 },
    { "action": "wait", "ms": 3000 },
    { "action": "start_challenge", "label": "The killer starts Just for the Fun of It", "actor": "k",
      "challenge": 158, "level": 1 },
    { "action": "assert", "actor": "k", "metric": "challenge_start_code", "equals": 0, "within_ms": 2000 },
    { "action": "start_challenge", "label": "The victim starts the same challenge", "actor": "v",
      "challenge": 158, "level": 1 },
    { "action": "assert", "actor": "v", "metric": "challenge_start_code", "equals": 0, "within_ms": 2000 },
    { "action": "set_aura", "actor": "v", "spell": 1004019, "stacks": 1 },
    { "action": "set_aura", "actor": "k", "spell": 1004019, "stacks": 1 },
    { "action": "set_aura", "actor": "o", "spell": 1004019, "stacks": 1 },
    { "action": "add_item", "actor": "v", "item": 723, "count": 20 },
    { "action": "add_item", "actor": "v", "item": 355242, "count": 1 },
    { "action": "set_money", "actor": "v", "value": 200000 },
    { "action": "pvp", "actor": "v", "enabled": true },
    { "action": "pvp", "actor": "k", "enabled": true },
    { "action": "set_health", "actor": "v", "value": 1 },
    { "action": "attack", "actor": "k", "target": "v" },
    { "action": "assert", "actor": "v", "metric": "alive", "equals": 0, "within_ms": 8000 },
    { "action": "assert", "actor": "k", "metric": "nearby_gameobject_count", "entry": 994300, "equals": 1,
      "within_ms": 5000 },
    { "action": "stop_attack", "actor": "k" },
    { "action": "use_nearby_gameobject", "label": "DISCRIMINATING: the challenger opens the victim's chest",
      "actor": "k", "entry": 994300 },
    { "action": "assert", "label": "The chest stays closed to the challenger", "actor": "k",
      "metric": "loot_count", "equals": 0 },
    { "action": "assert", "label": "The challenge says why", "actor": "k", "metric": "system_message_contains",
      "text": "Your challenge forbids looting the spoils of other players in High-Risk.", "equals": 1,
      "within_ms": 2000 },
    { "action": "use_nearby_gameobject", "label": "Control: a High-Risk player outside any challenge",
      "actor": "o", "entry": 994300 },
    { "action": "assert", "actor": "o", "metric": "loot_count", "min": 1 },
    { "action": "assert", "actor": "o", "metric": "system_message_contains",
      "text": "Your challenge forbids looting the spoils of other players in High-Risk.", "equals": 0 },
    { "action": "close_loot", "actor": "o" },
    { "action": "console", "label": "Revive the chest's owner", "command": "revive Harnessa" },
    { "action": "assert", "actor": "v", "metric": "alive", "equals": 1, "within_ms": 3000 },
    { "action": "set_aura", "actor": "v", "spell": 1004019, "stacks": 1 },
    { "action": "snapshot", "actor": "v", "metric": "carried_money", "save_as": "owner_money" },
    { "action": "use_nearby_gameobject", "label": "The owner opens their own chest under the same challenge",
      "actor": "v", "entry": 994300 },
    { "action": "assert", "actor": "v", "metric": "loot_count", "min": 1 },
    { "action": "assert", "actor": "v", "metric": "loot_gold", "min": 1 },
    { "action": "loot_money", "actor": "v" },
    { "action": "assert", "label": "The owner recovers the gold", "actor": "v", "metric": "carried_money",
      "relative_to": "owner_money", "min": 1 },
    { "action": "assert", "actor": "v", "metric": "system_message_contains",
      "text": "Your challenge forbids looting the spoils of other players in High-Risk.", "equals": 0 }
  ]
}
