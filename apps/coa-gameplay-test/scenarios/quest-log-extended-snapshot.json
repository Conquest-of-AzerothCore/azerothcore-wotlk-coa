    {
      "action": "assert",
      "label": "The 0x8F7 carries version 1",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 0,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The 0x8F7 is a full snapshot",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 1,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The 0x8F7 log size is 64",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 2,
      "equals": 64
    },
    {
      "action": "assert",
      "label": "The snapshot lists the five overflow quests",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 3,
      "equals": 5
    },
    {
      "action": "assert",
      "label": "The first entry is slot 25",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 4,
      "equals": 25
    },
    {
      "action": "assert",
      "label": "The first entry holds the 26th quest, Kobold Camp Cleanup (7)",
      "actor": "hero",
      "metric": "server_packet_u32",
      "opcode": 2295,
      "offset": 5,
      "equals": 7
    },
    {
      "action": "attack_nearby",
      "label": "Kill a Kobold Vermin",
      "actor": "hero",
      "entry": 6,
      "kill": true
    },
    {
      "action": "assert",
      "label": "The overflow quest counts the kill",
      "actor": "hero",
      "metric": "quest_objective_count",
      "quest": 7,
      "index": 0,
      "within_ms": 2000,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The kill sends a 0x8F7 delta",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 1,
      "within_ms": 2000,
      "equals": 0
