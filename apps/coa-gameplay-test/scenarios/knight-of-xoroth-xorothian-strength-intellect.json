      "label": "GUARD: Strength is at least 25, so whole-number rounding stays inside the bands",
      "actor": "knight",
      "metric": "stat",
      "stat": 0,
      "min": 25
    },
    {
      "action": "assert",
      "label": "GUARD: Intellect is at least 25, so whole-number rounding stays inside the bands",
      "actor": "knight",
      "metric": "stat",
      "stat": 3,
