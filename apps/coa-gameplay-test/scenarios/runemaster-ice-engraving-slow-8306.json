      "race": 1,
      "class": 32,
      "level": 60,
      "allow_regeneration": false,
      "spell_hit_rating": 10000,
      "melee_hit_rating": 10000,
      "expertise_rating": 10000
    }
  ],
  "creatures": [
    {
      "id": "enemy",
      "owner": "p",
      "entry": 36,
      "level": 60,
      "health": 1000000,
      "distance": 3
    }
  ],
  "steps": [
    { "action": "wait", "ms": 3000 },
    { "action": "add_item", "actor": "p", "item": 25 },
    { "action": "equip", "actor": "p", "item": 25, "slot": 15 },
    { "action": "snapshot", "actor": "enemy", "metric": "run_speed_rate", "save_as": "speed_before" },
    { "action": "attack", "actor": "p", "target": "enemy" },
    { "action": "wait", "ms": 3000 },
    {
      "action": "assert", "label": "BASELINE: melee without the engraving does not slow",
      "actor": "enemy", "metric": "aura", "spell": 653231, "caster": "p", "equals": 0
    },
    { "action": "set_aura", "actor": "p", "spell": 653266, "stacks": 1 },
    {
      "action": "assert", "label": "SETUP: the engraving triggers",
      "actor": "p", "metric": "spell_damage_count", "spell": 653217, "target": "enemy", "min": 1, "within_ms": 40000
    },
    {
      "action": "assert", "label": "CONTRACT: the trigger applies the slow",
      "actor": "enemy", "metric": "aura", "spell": 653231, "caster": "p", "equals": 1, "within_ms": 1000
    },
    {
      "action": "assert", "label": "CONTRACT: Icebound Momentum still applies",
      "actor": "enemy", "metric": "aura", "spell": 712490, "caster": "p", "equals": 1, "within_ms": 1000
    },
    {
      "action": "assert", "label": "CONTRACT: run speed is halved",
      "actor": "enemy", "metric": "run_speed_rate", "ratio_to": "speed_before", "min": 0.49, "max": 0.51
    }
