      "actor": "hero",
      "opcode": 2294,
      "fields": [
        {
          "u8": 1
        },
        {
          "u8": 30
        }
      ]
    },
    {
      "action": "assert",
      "label": "The server answers with the 0x8F7 snapshot",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 2295,
      "within_ms": 2000,
      "equals": 1
    },
    {
      "action": "assert",
      "label": "The snapshot log size is the client's 30, not Quests.LogSize 64",
      "actor": "hero",
      "metric": "server_packet_u8",
      "opcode": 2295,
      "offset": 2,
      "equals": 30
    },
