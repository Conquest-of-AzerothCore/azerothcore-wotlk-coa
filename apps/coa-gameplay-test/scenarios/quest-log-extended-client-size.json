{
  "schema": 1,
  "name": "Quest log: a client that announces 30 slots gets no quest in a slot it cannot show",
  "contract": [
    "With Quests.LogSize 64, a client that announces 30 slots in 0x8F6 has a log of 30: new quests take only slots 0-29, and the 31st quest is refused like on a full log, so no quest lands in a slot the client cannot show, abandon or swap."
  ],
  "timeout_ms": 120000,
  "quest_log_size": 64,
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 20
    }
  ],
  "creatures": [
    {
      "id": "willem",
      "owner": "hero",
      "entry": 823,
      "level": 20,
      "distance": 3
    }
  ],
