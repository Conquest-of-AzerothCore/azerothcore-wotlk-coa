[worldserver]

# Enable/disable the Manastorm gameplay module (requires restart).
Manastorm.Enable = 1

# Automatic affixes require this stage creature level and completion of the first native affix unlock depth.
# Individual progression affixes still require their matching native unlock/toast; those depths are unchanged.
Manastorm.AffixMinimumLevel = 50

# Client integration mode (requires restart):
#   1 = reconstructed 3.3.5 client addon transport (MANASTORM addon prefix)
#   2 = original Ascension native Manastorm protocol (uses the included CoA native opcode bridge)
Manastorm.ClientMode = 2

# Matching original client Manastorm.dbc, read-only identity validation in Mode 2.
# Default when omitted: <DataDir>/dbc/Manastorm.dbc.
# Manastorm.NativeDBCPath = "C:/path/to/matching/Manastorm.dbc"
# This module exclusively owns Manastorm requests and gameplay.
# The compatibility donor run service is never registered.
# AscensionCompat.Enable / remote-client admission remain core connection settings.

# Client UI fixes pushed as Lua 5 seconds after login (Mode 2 only, no client files).
# Bitmask, 0 = off and the stock client UI is left unchanged:
#   1 = the group finder keybind also opens inside a Manastorm run
#   2 = reward icons anchor below the Potential Rewards divider
#   4 = the queue panel handles an empty enterable-level list and uncached reward items
#   8 = the loadout flyout hides when there are no loadout spells
#  15 = all of the above
# A /reload drops them until the next login.
Manastorm.ClientUIFixes = 0

# Native Mobility covers all 36 listed class spell families automatically in Mode 2.
# Runtime supporting auras follow the active mixture and are removed outside your Manastorm stage.
# Requires the matching <DataDir>/dbc/Spell.dbc. No client files or SQL edits are needed.
