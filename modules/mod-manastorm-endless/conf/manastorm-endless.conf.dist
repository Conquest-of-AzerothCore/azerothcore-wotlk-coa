[worldserver]

# Enable/disable the Manastorm gameplay module (requires restart).
Manastorm.Enable = 1

# Client integration mode (requires restart):
#   1 = reconstructed 3.3.5 client addon transport (MANASTORM addon prefix)
#   2 = original Ascension native Manastorm protocol (uses the included CoA native opcode bridge)
Manastorm.ClientMode = 2

# Matching original client Manastorm.dbc, read-only identity validation in Mode 2.
# Default when omitted: <DataDir>/dbc/Manastorm.dbc.
# Manastorm.NativeDBCPath = "C:/path/to/matching/Manastorm.dbc"
# This module exclusively owns Manastorm requests and gameplay.
# The compatibility donor run service is never registered.
# AscensionCompat.Enable / remote-client admission remain core connection settings.

# Native client proof for Mobility + Elemental Burst (502828).
# 0: disabled (default). 1: patch Mobility 1300179-1300185 to family 38 in your private Manastorm stage.
# Other spell families are not covered by this test. Original client rows are restored outside that stage.
# Uses server DataDir/dbc/Spell.dbc and native opcode 0x092A; no client files are modified.
# Requires Manastorm.Enable=1, Manastorm.ClientMode=2 and a worldserver restart. Relog after enabling.
Manastorm.MobilityClientFamily38Test = 0
