[worldserver]

# Enable the module's drops and equipped powers.
CoALegendaryItems.Enable = 0

# Percent chance per eligible creature kill. At most one legendary drops per corpse.
CoALegendaryItems.DropChance = 0.05

# Players at this level or higher receive no new drops.
CoALegendaryItems.StopDropLevel = 45

# Players at this level or higher gain no powers from equipped legendaries.
CoALegendaryItems.StopPowerLevel = 60
