#
# CoA: Ascension client compatibility
#

[worldserver]

# Enable the compatibility packet filter.
CoA.Enable = 1

# One press of /s .rotation attempts one learned attack or heal on the selected target.
# Uses CoA specialization priorities with a basic fallback for other builds.
CoA.RotationAssist.Enable = 1

# Maximum crafted-item upgrade steps: 0 disables upgrade kits, 1 allows Refined,
# 2 allows Superior, and 3 allows Masterwork. Default: 2. Values are clamped to 0-3.
# Applies on startup and config reload; existing upgraded items remain unchanged.
# Shirts, bags/quivers, Arclight Spanner and excluded ambiguous families cannot be upgraded.
CoA.Crafting.MaxUpgradeSteps = 2

# Apply the Ascension protocol settings to remote connections as well as loopback
# (extension opcodes, ping interval, spell-modifier layout, class-10 mapping).
# Enable only on realms dedicated to the matching Ascension client build.
# Authentication proofs and packet size checks remain required. Restart to apply.
CoA.AllowRemoteClients = 0

# Ascension's classless character creator submits class ID 10 (Hero).
# 1 - Create a stock warrior shell instead.
# 0 - Create a Hero. Use this on a realm with CoA.ClassModel = "hero".
CoA.MapClass10ToWarrior = 1

# Client lab probe relay: the admin command .labprobe whispers read-only CoaProbe requests to an
# online lab character as addon messages and collects the chunked answers the addon whispers back.
# Accepted only for accounts whose name starts with CoA.ProbeRelay.AccountPrefix (case-insensitive).
# Enable only on a lab server. Default: 0.
CoA.ProbeRelay.Enable = 0
CoA.ProbeRelay.AccountPrefix = "COALAB"

CoA.LevelBoostNpc.Enable = 0
CoA.LevelBoostNpc.Level = 60
CoA.LevelBoostNpc.GoldReward = 5000
CoA.LevelBoostNpc.RuneOfDescensionReward = 2000000

# Log each consumed extension packet during protocol discovery.
CoA.LogConsumedPackets = 1

# Realm Bound Bazaar Tokens from the Elite Warchest (2977351). The 1500 Bazaar Tokens (975001) it holds are
# counted as a per-account reserve: purchases use the reserve first, and tokens can only be traded, mailed to
# another account, auctioned or put in a guild bank while the account keeps at least the reserve. Mail between
# the account's own characters is free. Farmed tokens above the reserve stay tradeable.
CoA.BazaarTokens.WarchestRealmBound = 1

CoA.BazaarTokens.HourlyCap.Amount = 0
CoA.BazaarTokens.HourlyCap.WindowSeconds = 3600

# PTR character copy: players copy their own characters from another realm with .ptr list and .ptr copy <name>.
# Enable it only on the PTR. SourceDatabase is the source realm's characters schema on the same MySQL server;
# this realm's characters DB user needs SELECT on it. Both realms must share the auth database, because the copy
# keeps the account id. A character has at most one live copy; after deleting it, the next copy waits
# CooldownSeconds from the previous one.
CoA.PtrCopy.Enable = 0
CoA.PtrCopy.SourceDatabase = ""
CoA.PtrCopy.SourceRealmName = "Rexxar"
CoA.PtrCopy.CooldownSeconds = 3600

# Ascension character screen: enable/disable (activate/deactivate) and the
# per-account character list sort order.
# Requests: CMSG 0x072E / 0x072F / 0x0772.
# Responses: SMSG 0x075E / 0x075F / 0x0760 / 0x076F / 0x0770 / 0x0771.
CoA.CharacterSelectionEnable = 1

# Maximum simultaneously active characters per account (1-128).
# Deactivated characters stay stored, are hidden from the standard character
# list and can be re-activated later.
CoA.CharacterSelectionMaxActive = 128

# Automatically add appearance and vanity entries for items obtained by a character.
CoA.AutoCollectAppearances = 1

# Drop at most one wearable item matching an enemy's visible equipment on a rewarded kill.
# Uses NPC display presets or CreatureDisplayInfoExtra, plus the current weapon/shield entries.
# Only unbound/BoE gear up to uncommon quality, at or below the enemy's level, is eligible.
# Stats prefer caster Intellect, defender defenses/Stamina or physical Strength/Agility.
# The per-kill percentage is a local reconstruction default; original rates were not captured.
CoA.EquippedGearLoot = 1
CoA.EquippedGearLootChance = 5

# Health and damage multipliers for regular-difficulty creatures, tuned to live Ascension readings.
# Health is multiplied when a creature takes its level; damage applies to hits on players and their pets.
# Heroic/Mythic, battlegrounds, arenas, pets, summons, totems, triggers, critters and training dummies are
# not changed; raid creatures listed in coa_boss_flex keep their measured flex health.
# MapHealth/MapDamage replace the context value per map as "mapId:multiplier".
# Every value may also be a formula of the creature's level: numbers, level, + - * /, parentheses, min(a, b) and
# max(a, b), e.g. CoA.CreatureScaling.World.Health = "1.17 + 0.013 * level". In MapHealth/MapDamage write a formula
# without spaces ("43:0.3+0.08*level"), or separate the entries with ';' ("43: 0.3 + 0.08 * level; 36: 2.2").
# World health is fitted to live open-world creature health seen in videos of live Ascension (levels 1-59). World
# melee damage is half the base of the fit to a live video of a level 1 Duskbat hitting a new level 1 character
# (72 armor) for 5-8 ("4.32 + 0.013 * level"), as the live PTR now does. Dungeon and Raid keep their earlier estimates.
# Without this section the server keeps these multipliers but leaves the feature disabled.
CoA.CreatureScaling.Enable = 1
CoA.CreatureScaling.World.Health = "1.17 + 0.013 * level"
CoA.CreatureScaling.Dungeon.Health = 2.5
CoA.CreatureScaling.Raid.Health = 2.2
CoA.CreatureScaling.MapHealth = "36:2.2 43:2.0 229:4.0 389:3.0 469:5.0"
CoA.CreatureScaling.World.Damage = "2.16 + 0.013 * level"
CoA.CreatureScaling.Dungeon.Damage = 1.5
CoA.CreatureScaling.Raid.Damage = 1.0
CoA.CreatureScaling.MapDamage = ""
# Melee damage spread: the creature's highest normal hit over its lowest, around the same average (live open-world
# normal creatures 1.5-1.6 from player combat logs; wider at level 1, where the same Duskbat video hits 5-8).
# 0 keeps the stock range. Formulas and MapDamageSpread as above.
CoA.CreatureScaling.World.DamageSpread = "max(1.55, 1.85 - 0.05 * level)"
CoA.CreatureScaling.Dungeon.DamageSpread = 0
CoA.CreatureScaling.Raid.DamageSpread = 0
CoA.CreatureScaling.MapDamageSpread = ""
# Spell and periodic damage from creatures. Damage above covers melee swings and melee/ranged spells (weapon strikes,
# bleeds); every other open-world spell takes World.SpellDamage instead. Live creature spells hit for about their
# spell data value at the creature's own level in player combat logs, so the default is unscaled. Dungeons and raids
# have no spell factor of their own: their spells keep Dungeon.Damage/Raid.Damage unless MapSpellDamage names the map.
# Formulas and MapSpellDamage as above.
CoA.CreatureScaling.World.SpellDamage = 1
CoA.CreatureScaling.MapSpellDamage = ""

# Live-like magic resistance for NPCs not controlled by players, including Holy
# (docs/coa/monster-linear-resistance.md). Each combat level adds PerLevel resistance to every magic school;
# penetration and debuffs reduce it to at least 0. Every PerPercent resistance adds 1% average resist, capped by
# MaxReductionPct. Direct hits and DoT ticks roll the native 10% partial-resist steps around that average; damaging
# spells are never fully resisted, crowd control can be. Players, pets and charmed creatures keep the native rules.
# PerPercent is a reconstruction choice, not a verified live value.
# 1 - enabled (default).
# 0 - native resistance, including the hidden level-difference term and the Classic+ resist table.
CoA.MonsterResistance.Enable = 1
CoA.MonsterResistance.PerLevel = 1.0
CoA.MonsterResistance.PerPercent = 5.0
CoA.MonsterResistance.MaxReductionPct = 75.0

# Level stats of the Ascension classes 12-32: level-60 base stats, base health and base mana from coa.bisbeard.com
# with the race adjustments (ascension_class_stats, ascension_race_class_stats). Necromancer minions keep their
# health either way. Restart to apply.
# 1 - enabled.
# 0 - the previous player_class_stats curve without race adjustments (default).
CoA.ClassLevelSixtyStats.Enable = 0

# Resilient Constitution (spell 552011), the class passive that lowers damage from players and their pets.
# DamageReductionPct lowers every hit; CriticalReductionPct lowers critical hits again on top of it, so 50 and 20
# leave 50% of a normal hit and 40% of a critical one. A player's pet gets PetSharePct percent of both reductions
# through its owner's aura. Values are percentages from 0 to 100; higher values are capped at 100.
CoA.ResilientConstitution.DamageReductionPct = 50
CoA.ResilientConstitution.CriticalReductionPct = 20
CoA.ResilientConstitution.PetSharePct = 85

# Wardrobe, outfits, vanity and mount/companion collections for characters played by bots.
# 0 - never: bot sessions skip the collections (default).
# 1 - only characters of player accounts played as bots (alts), never random bot accounts:
#     their saved outfits and appearances are applied as for the player.
# 2 - every bot session.
# Random bot accounts are recognised by their name prefix, CoA.RandomBotAccountPrefix, which
# must match AiPlayerbot.RandomBotAccountPrefix of mod-playerbots (default: rndbot).
CoA.CollectionsForBots = 0
CoA.RandomBotAccountPrefix = "rndbot"

# Solo-server convenience: unlock the complete local appearance catalog. The
# per-category value balances the initial snapshot; remaining appearances are
# streamed afterward to stay below the legacy client's 64 KiB packet limit.
CoA.UnlockLocalAppearanceCatalog = 1
CoA.AppearanceCatalogPerCategory = 500

# Solo-server convenience: expose every static VanityCollection entry as account-owned.
# Custom Ascension-only entries still require matching server item/spell templates to deliver.
CoA.UnlockAllVanity = 1

# Vanity items every account owns from its first login, as space-separated item ids. They are
# recorded in the account's collection, so they stay owned with CoA.UnlockAllVanity = 0, and
# CoA.LearnOwnedCompanions teaches their mount/companion spells. Ids missing from the client's
# VanityCollection.dbc and consumable entries are skipped.
# Example: "98457 134987" (Book of Ascension and Book of Artisans).
# Default: ""
CoA.StarterVanityItems = ""

# If a vanity item has no server item template but its DBC row names a valid spell,
# learn that spell directly when delivery is requested.
CoA.AllowLearnedSpellDelivery = 1

# Teach owned Vanity mount/companion spells permanently, in small login batches.
# Ownership remains unchanged. Entries without a local spell are not invented.
CoA.LearnOwnedCompanions = 1

# Solo-server convenience: all riding ranks (300/300) and Cold Weather Flying
# from the first login, including level-one characters. No profession grants.
CoA.MaxRidingFromStart = 1

# Mount flight rules.
# 0 - Players fly with Expert Riding or better in Outland, and in Northrend once they know Cold
#     Weather Flying; never in Azeroth, battlegrounds, battlefields or no-fly areas. Every mount
#     follows this rule, Ascension's own mounts such as Ash'adar included, and a rider who leaves
#     a flying area is dismounted.
# 1 - Flight as before PR #8631: the rule above applies only to mounts in the spellbook, Ash'adar
#     never flies, other mounts fly wherever their own spell allows, and nobody is dismounted
#     when leaving a flying area.
# Applies on startup and config reload.
# Default: 0
CoA.LegacyMountFlight = 0

# Give a character that carries none of the three PvP ruleset auras the PvE set at login,
# because character creation grants no ruleset and the client's selection frame is level- and
# rested-area gated. The PvE set is the PvE Mode aura 9931032 alone, exactly what pressing
# "PvE Mode" applies. Independently of this setting, a character carrying the War Mode aura 1004119
# next to PvE Mode loses the War Mode aura at login.
# Set to 0 to leave such characters on Ruleset.None instead.
CoA.RulesetLoginDefault = 1

# War Mode (1004119 without PvE Mode) and High-Risk (1004019) keep creature, chest and quest level
# scaling in the open world, as on Ascension. Set to 1 to switch level scaling off for both rulesets
# in the open world. Instances keep the character's own choice.
CoA.Ruleset.DisableLevelScaling = 0

# GatherMate gathering areas (pools 20000000-20099999) keep a share of their spots up that follows the
# players in the area's zone: MinFraction with nobody there, plus PerPlayerFraction for each player, up to
# MaxFraction. The limit is read whenever a node respawns, so a zone fills up or thins out as nodes are
# gathered; nothing is deleted. Set ScaleWithZonePlayers to 0 to use the pool_template max_limit instead.
CoA.GatherNodes.ScaleWithZonePlayers = 1
CoA.GatherNodes.MinFraction = 0.10
CoA.GatherNodes.PerPlayerFraction = 0.015
CoA.GatherNodes.MaxFraction = 0.35

# Quests with a row in the client's QuestTemplateScaling.dbc trail the character: the row's highest
# point at or below the character's level sets the quest to that level plus its offset (the shipped
# rows trail by 4 to 1 levels), held within the row's minimum and maximum level and never below the
# quest's own level. Experience is priced at that level, and money by its tier's ratio between that
# level and the quest's own. Quests without a row keep their authored level.
CoA.QuestLevelScaling = 1

# Mark a quest on its curve with the client's scaling flag (0x01000000), which colours it "standard"
# instead of by level. Live quest caches never carried the flag.
CoA.QuestLevelScaling.ClientFlag = 0

# Weapons and armor dropped by level-scaled creatures, found in chests by characters who chose
# level scaling or given by level-scaled quests are lifted to the level of that content, rounded down
# to a step of five levels, as copies with entries from 4400001 up. Shirts, tabards and items without
# an item level are left as they are.
# Set to 0 to stop new lifts; copies already handed out keep working. While native item scaling
# (CoA.ItemScaling.Native) is active no new copies are made either.
CoA.ItemScaling = 1

# Weapons and armor that the client's ItemStat.dbc has a level ladder for keep their own entry and are
# given a scaling level instead of a copy: the looter's level plus LootLevelOffset, from 1 to 65, set
# once when the item is looted, won in a roll or, with QuestRewards, given by a quest. Inside a dungeon
# listed in DestinyWeaver.Scaling.DungeonIds loot scales for everyone, up or down, to the looter's level.
# Their stats come from the ladder row for that level, and the client asks for the same row with opcode 0x6FF.
# Worldforged items and items the copy path never lifts stay as they are. While it is active the copy
# path (CoA.ItemScaling) makes no new copies at all; copies already handed out keep working.
# Read at startup only. With 0, items keep their authored stats and the copy path handles them again.
CoA.ItemScaling.Native = 1
CoA.ItemScaling.Native.LootLevelOffset = 0
CoA.ItemScaling.Native.QuestRewards = 1

# RebornArmor gives every class but the classless Hero the reborn armor the client shows them: the
# ladder row's second armor column for a scaled item, ItemAddon.dbc's reborn armor for an authored one
# (items without that value keep their own armor). The stat reply then carries both columns. With 0,
# items give their full armor to everyone and the reply repeats it. Needs Native; read at startup only.
CoA.ItemScaling.Native.RebornArmor = 1

# Automatic progression: hand out the class abilities and rank upgrades for the
# character's class and level as they level up. Set to 0 to stop that
# and let the player ask instead - a Book of Ascension grants them, so a realm that
# wants the books to be the way abilities are earned runs with this off. A talent
# tree's free nodes are granted either way: the books do not sell them. Reloadable.
CoA.AutoProgression = 0

# Stream the CreatureDisplayInfo patch rows the installed Ascension client cannot
# resolve from its own files (custom display ids). The stream starts after the
# client's extension handshake, with a short login fallback when it never arrives.
CoA.SendDisplayPatches = 1

# Unpatched copy of the client's CreatureDisplayInfo.dbc, used to stream exactly
# the rows the client is missing. Empty selects DataDir/dbc_clientset; when the
# copy is unavailable, the server's own DataDir/dbc/CreatureDisplayInfo.dbc is used,
# so only rows added through creaturedisplayinfo_dbc are streamed.
CoA.ClientDbcDirectory = ""

# Extension range derived from the installed client's opcode dispatch table.
# Keep these values decimal because ConfigMgr numeric values are parsed as decimal.
CoA.FirstExtensionOpcode = 1311
CoA.LastExtensionOpcode = 2515

# Experimental local Manastorm. Requires the matching character migration and client UI patch.
# Startup-only: solo levels 10-59, three scenes, depths 1-15. Realm level cap is unchanged.
# Enable only with the reviewed installation package; native gameplay acceptance is still required.
Ascension.Manastorm.Enable = 0

# What kind of realm the client is told it is on: one or more of live,
# seasonal, league, ptr and development, separated by spaces. Each type sent
# opens the client's rows flagged for it, so "live seasonal" shows the
# Character Advancement entries of both, as a seasonal realm on live
# infrastructure does. An empty or unknown value sends live.
#
# This is not cosmetic. The client builds its vanity catalogue only from rows
# that match an active realm type, so with none set the Vanity Collection stays
# empty no matter what the account owns.
# Default: live
CoA.RealmType = "live"

#
#    CoA.ClassModel
#        Description: Character-creation mode advertised to the client in
#                     SMSG_REALM_INFO when the character list is requested.
#                     "coa"  - Conquest of Azeroth classes. Default.
#                     "wcr"  - Warcraft Reborn (classic) classes.
#                     "hero" - free-pick Hero.
#        Default:     "coa"
#

CoA.ClassModel = "coa"

# Enable spell 86000's passive 15% unmounted running-speed aura on this realm.
# Stronger ordinary running-speed auras replace its bonus; they do not add to it.
# Mount, swim and flight speeds are unchanged. Requires a worldserver restart.
# Opt in for Area 52; leave disabled on other realms to preserve their behavior.
Ascension.RunSpeedAura.Enable = 0

#
#    CoA.GameModeMask
#        Description: Custom game-mode bits sent to the client when a character logs in, which
#                     turn on the matching client UI and rules. Add values to combine modes.
#                     2    - Ironman
#                     4    - Survivalist
#                     8    - Draft
#                     32   - Resolute
#                     64   - Wildcard
#                     128  - Felforged
#                     256  - Nightmare
#                     2048 - Build Draft
#                     4096 - Crusader
#        Default:     0 - no custom game mode
#

CoA.GameModeMask = 0

#
#    CoA.ClientBooleanConfigs
#    CoA.ClientIntegerConfigs
#        Description: Extra client configs sent in SMSG_COA_CONFIG, as a comma-separated NAME=value list.
#                     They select realm-specific client UI, for example
#                     "CONFIG_LEGACY_CHARACTER_ADVANCEMENT_ENABLED=0" loads the current Character
#                     Advancement UI instead of the Season 9 one on a free-pick realm.
#        Default:     "" - none
#

CoA.ClientBooleanConfigs = ""
CoA.ClientIntegerConfigs = ""

###################################################################################################
# HIGH-RISK PACKAGE
#
#    HighRisk.Losses
#        Description: Deaths in the open world while under the High-Risk ruleset (aura 1004019) move
#                     tradeable equipment, bag resources and gold into a persistent chest that any
#                     living High-Risk player nearby can recover. Kill XP is unchanged: the ruleset
#                     aura already carries the native bonus.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.Losses = 0

#    HighRisk.GearChance
#    HighRisk.ResourceChance
#    HighRisk.GoldChance
#        Description: Percent chance, per eligible death, that each category is lost. Realm tuning,
#                     not verified Ascension rates. If every roll misses, one available category is
#                     still chosen so an eligible death never silently produces no chest.
#        Default:     50

HighRisk.GearChance = 50
HighRisk.ResourceChance = 50
HighRisk.GoldChance = 50

###################################################################################################
# RATED SOLO ARENA
#
#    RatedSoloArena.RoleBalanceWaitSeconds
#        Description: Seconds the oldest rated solo queue entry waits before matchmaking may ignore the
#                     healer balance (one healer per side or none). Balanced lineups stay preferred.
#        Default:     60
#                     0 - (Never relax the healer balance)

RatedSoloArena.RoleBalanceWaitSeconds = 60

#    RatedSoloArena.RoleBalance.2v2
#    RatedSoloArena.RoleBalance.3v3
#        Description: Whether rated solo lineups of the bracket require the healer balance until
#                     RatedSoloArena.RoleBalanceWaitSeconds has elapsed. When disabled, any split is
#                     accepted from the start and a role-balanced split is still preferred when one exists.
#        Default:     0 - (2v2: double damage lineups allowed)
#                     1 - (3v3: healer balance required)

RatedSoloArena.RoleBalance.2v2 = 0
RatedSoloArena.RoleBalance.3v3 = 1

#    RatedSoloArena.Win.ArenaPoints.1v1
#    RatedSoloArena.Win.ArenaPoints.2v2
#    RatedSoloArena.Win.ArenaPoints.3v3
#        Description: Arena Points granted to each winner of a rated solo or party match, by bracket.
#        Default:     25 (1v1), 300 (2v2), 300 (3v3)

RatedSoloArena.Win.ArenaPoints.1v1 = 25
RatedSoloArena.Win.ArenaPoints.2v2 = 300
RatedSoloArena.Win.ArenaPoints.3v3 = 300

#    RatedSoloArena.Win.RunesOfAscension
#        Description: Runes of Ascension (item 375250) granted to each winner of a rated solo or party match.
#        Default:     25

RatedSoloArena.Win.RunesOfAscension = 25

#    RatedSoloArena.SeasonCap.PerWeek
#        Description: Conquest cap on Arena Points earned from rated solo arena wins during the current
#                     arena season. The cap grows by this amount at each weekly reset since the season
#                     started (week 1 = one step).
#        Default:     12000

RatedSoloArena.SeasonCap.PerWeek = 12000

#    RatedSoloArena.SeasonCap.Max
#        Description: Upper limit of the season conquest cap.
#        Default:     0 - (No limit)

RatedSoloArena.SeasonCap.Max = 0

#    RatedSoloArena.Tier.Combatant
#        Description: Personal rating shown as the Combatant rank in the PvP frame. Combatant has no title.
#        Default:     1400

RatedSoloArena.Tier.Combatant = 1400

#    RatedSoloArena.Title.Challenger
#    RatedSoloArena.Title.Rival
#    RatedSoloArena.Title.Duelist
#    RatedSoloArena.Title.Gladiator
#        Description: Personal rating in a rated solo bracket that grants the matching character title
#                     the first time it is reached. Titles are never removed.
#        Default:     1700 (Challenger), 2000 (Rival), 2300 (Duelist), 2600 (Gladiator)

RatedSoloArena.Title.Challenger = 1700
RatedSoloArena.Title.Rival = 2000
RatedSoloArena.Title.Duelist = 2300
RatedSoloArena.Title.Gladiator = 2600

#    Ascension.PvPVendors.ReleaseStage
#        Description: The newest PvP Season 1 vendor phase the realm has released, 0-2. Each phase's
#                     vendors stand in Champion's Hall and the Hall of Legends only once it is released,
#                     and earlier phases stay. Changes apply on .reload config.
#                     0 - No Season 1 PvP vendors
#                     1 - Phase 1: Lieutenant Thorne 48051/48052, Quartermaster Hadwin, Captain Korgash
#                         49050/49051 and Warbringer Krogash (Corporal's, Grunt's, Challenger's,
#                         Sergeant's and Captain's)
#                     2 - Phase 2 as well: Lieutenant Thorne 48053, Captain Korgash 49053 and both
#                         Vik "Angry" Smalls (CoA PvP Gear, Legionnaire's, Centurion's and the Legacy lists)
#        Default:     1

Ascension.PvPVendors.ReleaseStage = 1

#    HighRisk.FelCommutation.Enable
#        Description: Fel Commutation. A High-Risk character switches it on and picks the equipment slots to
#                     insure in the window at the Fel Commutation Portal (object 8000053). While on, items in
#                     insured slots that a High-Risk death would drop are kept if the character carries
#                     enough gold for the fee, and the fee goes into the death chest. If the gold is short,
#                     the character keeps it and the items drop. The normal gold loss
#                     (HighRisk.GoldChance) still applies on top, from the gold left after the fees; the
#                     death message shows the two parts separately.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.FelCommutation.Enable = 0

#    HighRisk.FelCommutation.FeeMultiplier
#        Description: Multiplier applied to the fee. The fee is one amount per death, as the client shows it:
#                     the whole average equipped item level times the client's rate band for that level, plus
#                     10 gold at the maximum player level (for example 74 x 1500 copper + 10 gold = 21g 10s).
#        Default:     1.0

HighRisk.FelCommutation.FeeMultiplier = 1.0

#    HighRisk.FelCommutation.MaxSlots
#        Description: Equipment slots a character may insure at once. 0 means no limit.
#        Default:     0

HighRisk.FelCommutation.MaxSlots = 0

#    HighRisk.FelCommutation.AltarRange
#        Description: Distance in yards within which the portal must stand for the switch to be accepted.
#        Default:     20

HighRisk.FelCommutation.AltarRange = 20

#    HighRisk.FelCommutation.ToggleAnywhere
#        Description: Accept the switch without a portal nearby (for example from a companion).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.FelCommutation.ToggleAnywhere = 0

#    HighRisk.FelCommutation.ClickToggle
#        Description: Show an Activate/Deactivate button in the Fel Commutation window that switches
#                     Fel Commutation for all equipped gear. Using the portal only opens or closes the
#                     window. The original client still sends the switch itself when the portal is used
#                     (its Extensions.dll raises GAMEOBJECT_USED and its Lua sends the switch packet).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

HighRisk.FelCommutation.ClickToggle = 0

#    PvpPower.Enable
#        Description: PvP Power on equipped items (the value in ItemAddon.dbc, else the item's "PvP Power
#                     (+N)" spell) scales damage and healing at level 60, capped at 495 points. Damage +0.05% per point against players (and against uncontrolled
#                     creatures for a High-Risk attacker in the open world); creature damage received
#                     there -0.05% per point; healing and shields +0.02% per point in War Mode,
#                     High-Risk open world and battlegrounds.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PvpPower.Enable = 1

#    PvePower.Enable
#        Description: PvE Power on equipped items (the value in ItemAddon.dbc, else the item's "PvE Power
#                     (+N)" spell) scales damage and healing at level 60, capped at 495 points. Damage dealt to creatures +0.05% per point and damage received from
#                     creatures -0.05% per point on every map; healing and shields +0.02% per point in
#                     dungeons and raids. Stacks with PvP Power.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PvePower.Enable = 1

#    Bloodforged.Enable
#        Description: Adds Bloodforged equipment to the native loot roll of eligible open-world
#                     creature corpses for High-Risk players from level 15, drawn from the reviewed
#                     catalogue in coa_bloodforged_catalogue. The item pool and rate band follow the
#                     player's level; creatures grey to the player give no roll. Drops obey the
#                     standard corpse item limit and are scaled by Bloodforged.DropRate.Rare and
#                     .Epic (not by Rate.Drop.Item.*). Requires PvpPower.Enable.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Bloodforged.Enable = 0

#    HighRisk.ReleaseStage
#        Description: The release stage 0-8 of High-Risk content, set apart from the rest of the realm
#                     (Ascension.CallboardCache.ReleaseStage and .raidphase do not change it). It decides
#                     which raids' Bloodforged gear (normal and Heroic copies) can drop and which Heroic
#                     items Crow's Cache gives, and picks the stage value of
#                     Bloodforged.EpicMaxItemLevelByStage and Bloodforged.BlueMaxItemLevelByStage.
#                     Stages: 0 normal dungeons, 1 Heroic Dungeons, 2 Mythic Dungeons, 3 Zul'Gurub,
#                     4 Molten Core, 5 Onyxia's Lair, 6 Blackwing Lair, 7 Ahn'Qiraj, 8 Naxxramas.
#                     Applied on .reload config. .hr stage set <1-8> overrides this value in the
#                     characters database until .hr stage clear; .hr stage shows the stage.
#        Default:     3

HighRisk.ReleaseStage = 3

#    Bloodforged.Rates15
#    Bloodforged.Rates25
#    Bloodforged.Rates35
#    Bloodforged.Rates45
#    Bloodforged.Rates55
#        Description: Base percent per eligible corpse for the level band starting at that level, as
#                     three values: uncommon, rare, epic. One roll per quality, spread evenly across
#                     that quality's pool, before the Bloodforged.DropRate.* multipliers. Uncommon is 0:
#                     Bloodforged drops are rare or epic only. A non-zero uncommon rate must be
#                     above the rare one. Elite mobs use Bloodforged.EliteEpicPercent for epics instead.
#        Default:     "0.00 0.50 0.00", "0.00 1.00 0.00", "0.00 1.40 0.15", "0.00 1.80 0.25", "0.00 2.20 1.00"

Bloodforged.Rates15 = "0.00 0.50 0.00"
Bloodforged.Rates25 = "0.00 1.00 0.00"
Bloodforged.Rates35 = "0.00 1.40 0.15"
Bloodforged.Rates45 = "0.00 1.80 0.25"
Bloodforged.Rates55 = "0.00 2.20 1.00"

#    Bloodforged.EliteEpicPercent
#        Description: Percent chance for a High-Risk elite (Bloodforged.HighRiskEliteEntries) to drop one epic
#                     Bloodforged item that is not raid gear, within the stage cap, before the
#                     Bloodforged.DropRate.Epic multiplier. Comes on top of its rare (blue) roll.
#        Default:     15

Bloodforged.EliteEpicPercent = 15

#    Bloodforged.EliteHeroicUpgradePercent
#        Description: Percent chance that the epic from Bloodforged.EliteEpicPercent is a Heroic
#                     Bloodforged item instead, never raid gear, within the stage cap. Decimals allowed.
#        Default:     2.5

Bloodforged.EliteHeroicUpgradePercent = 2.5

#    Bloodforged.BlueMaxItemLevelByStage
#        Description: Highest item level of a rare (blue) Bloodforged item that drops, one value per
#                     High-Risk release stage 0-8 (HighRisk.ReleaseStage). The lowest allowed
#                     value is 57, the lowest item level of the level 60 blue items: a lower value is
#                     raised to 57 and logged. Raid gear of released raids is not limited by it.
#        Default:     "57 57 57 57 57 57 57 57 57"

Bloodforged.BlueMaxItemLevelByStage = "57 57 57 57 57 57 57 57 57"

#    Bloodforged.EpicMaxItemLevelByStage
#        Description: Highest item level of an epic Bloodforged item that drops, one value per
#                     High-Risk release stage 0-8 (HighRisk.ReleaseStage). Raid gear of
#                     released raids is not limited by it.
#        Default:     "61 61 64 65 70 70 70 70 70"

Bloodforged.EpicMaxItemLevelByStage = "61 61 64 65 70 70 70 70 70"

#    Bloodforged.Level60EndgameZonesOnly
#        Description: Bloodforged items that require level 60 drop only in Western Plaguelands,
#                     Eastern Plaguelands, Burning Steppes, Blasted Lands, Azshara, Winterspring,
#                     Un'Goro Crater and Silithus.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Bloodforged.Level60EndgameZonesOnly = 1

#    Bloodforged.RareRaidItemPercent
#    Bloodforged.RareEliteRaidItemPercent
#        Description: Rare (rank 4) and rare elite (rank 2) mobs always drop one epic Bloodforged
#                     item (rare quality when no epic fits the player's level) and one Heroic
#                     Bloodforged item instead of the normal roll. The two values
#                     are the percent chance that the Bloodforged item, and the Heroic
#                     Bloodforged item, is epic raid gear of a released raid. Blue raid gear
#                     comes only from Bloodforged.ExtraBluePercent.
#        Default:     "15 5", "25 10"

Bloodforged.RareRaidItemPercent = "15 5"
Bloodforged.RareEliteRaidItemPercent = "25 10"

#    Bloodforged.ExtraBluePercent
#    Bloodforged.ExtraBlueRaidItemPercent
#        Description: Rare mobs, rare elite mobs and the High-Risk elites in
#                     Bloodforged.HighRiskEliteEntries have a Bloodforged.ExtraBluePercent chance to
#                     drop one more rare (blue) Bloodforged item on top of their other drops. That
#                     blue item is blue raid gear of a released raid with a
#                     Bloodforged.ExtraBlueRaidItemPercent chance, when such a raid has blue items;
#                     otherwise it comes from the normal blue pool. Not scaled by any drop rate
#                     multiplier. 0 turns it off.
#        Default:     50, 50

Bloodforged.ExtraBluePercent = 50
Bloodforged.ExtraBlueRaidItemPercent = 50

#    Bloodforged.EndgameRareRespawnMinutes
#    Bloodforged.EndgameRareEliteRespawnMinutes
#        Description: Respawn time of rare (rank 4) and rare elite (rank 2) mobs in the level 60
#                     zones listed under Bloodforged.Level60EndgameZonesOnly, as shortest and
#                     longest minutes. A new random time is chosen at every death. "0 0" keeps
#                     the spawn's own respawn time.
#        Default:     "90 150", "150 210"

Bloodforged.EndgameRareRespawnMinutes = "90 150"
Bloodforged.EndgameRareEliteRespawnMinutes = "150 210"

#    Bloodforged.EndgameRareRespawnMinLevel
#        Description: Lowest creature level that gets the random respawn time above.
#        Default:     45

Bloodforged.EndgameRareRespawnMinLevel = 45

#    Bloodforged.EndgameEliteHighRiskRespawnMinutes
#        Description: Respawn time of an elite (rank 1) mob in the level 60 zones listed under
#                     Bloodforged.Level60EndgameZonesOnly when a High-Risk player (or their pet) killed it
#                     or owns its loot, as shortest and longest minutes, chosen at random at every such
#                     death. Kills by other players keep the spawn's own respawn time, and so do elites
#                     whose own respawn time is at least the shortest value. "0 0" turns it off.
#                     The High-Risk elites in Bloodforged.HighRiskEliteEntries use
#                     Bloodforged.HighRiskEliteRespawnMinutes instead.
#        Default:     "10 15"

Bloodforged.EndgameEliteHighRiskRespawnMinutes = "10 15"

#    Bloodforged.HighRiskEliteRespawnMinutes
#        Description: Respawn time of the High-Risk elites in Bloodforged.HighRiskEliteEntries in the open
#                     world, as shortest and longest minutes, chosen at random at every death, whoever
#                     killed them. "0 0" keeps the spawn's own respawn time.
#        Default:     "45 60"

Bloodforged.HighRiskEliteRespawnMinutes = "45 60"

#    Bloodforged.HighRiskEliteEntries
#        Description: Creature entries, separated by spaces, of the High-Risk elite mobs. Only these get
#                     the elite rules: Bloodforged.EliteEpicPercent, Bloodforged.EliteHeroicUpgradePercent,
#                     the elite Ephemeral Key chance and elite Marks of War. Every other elite drops like a
#                     normal mob. The default lists Ascension's High-Risk elites (Scarlet Master Smith and
#                     Skinner, Cult of the Damned, Azshara, Silithus and elemental elites, 918530-919450).
#        Default:     "918530 918547 918550 918555 918562 918563 918578 918588 918589 918590 918591 918647 918648 918690 919448 919450"

Bloodforged.HighRiskEliteEntries = "918530 918547 918550 918555 918562 918563 918578 918588 918589 918590 918591 918647 918648 918690 919448 919450"

#    Bloodforged.EndgameRareMinRequiredLevel
#        Description: In the level 60 zones listed under Bloodforged.Level60EndgameZonesOnly, rare and
#                     rare elite mobs drop only Bloodforged items (normal, Heroic and raid gear) that
#                     require at least this level, whatever the looter's level. 0 uses the looter's
#                     level pool as everywhere else.
#        Default:     60

Bloodforged.EndgameRareMinRequiredLevel = 60

#    Bloodforged.RareHiddenCachePercent
#    Bloodforged.EpicHiddenCachePercent
#        Description: High-Risk Hidden Caches (loot 9670 / 9671 / 9672, opened with an Ephemeral Key) add
#                     Bloodforged items that require level 60 within the stage cap. A Hidden Cache always
#                     gives one rare (blue) item. A Rare Hidden Cache always gives one epic and has the
#                     two percent chances for a Heroic Bloodforged item and for raid gear of a released
#                     raid. An Epic Hidden Cache always gives one raid item of a released raid (an epic
#                     before any raid is released) and one epic; the two percent chances are for the raid
#                     item to be its Heroic copy and for the epic to be a Heroic Bloodforged item.
#        Default:     "15 5", "5 15"

Bloodforged.RareHiddenCachePercent = "15 5"
Bloodforged.EpicHiddenCachePercent = "5 15"

#    Bloodforged.EphemeralKeyPercent
#        Description: Percent chance for an Ephemeral Key (967680, opens a Hidden Cache) from a creature
#                     killed by a High-Risk player in the open world, when the creature is not grey to
#                     them, as four values: normal (and every other elite), High-Risk elite
#                     (Bloodforged.HighRiskEliteEntries), rare, rare elite.
#                     Decimals allowed. Not scaled by any drop rate multiplier.
#        Default:     "8 50 100 100"

Bloodforged.EphemeralKeyPercent = "8 50 100 100"

#    Bloodforged.HighRiskEliteExtraKeyPercent
#        Description: Percent chance that the Ephemeral Key a High-Risk elite (Bloodforged.HighRiskEliteEntries)
#                     drops is two keys instead of one. It is only rolled when the High-Risk elite value of
#                     Bloodforged.EphemeralKeyPercent gave a key, so such a kill gives 0, 1 or 2 keys.
#                     Decimals allowed. Not scaled by any drop rate multiplier.
#        Default:     10

Bloodforged.HighRiskEliteExtraKeyPercent = 10

#    Bloodforged.DropRate.Rare
#    Bloodforged.DropRate.Epic
#        Description: Turns Bloodforged rare (blue) and epic drops from mobs up or down. The chance
#                     from Bloodforged.Rates* (normal mobs and ordinary elites) and the High-Risk elite
#                     epic chance (Bloodforged.EliteEpicPercent) are multiplied by these values, and a
#                     chance never goes above 100%. Example: Rates55 = "0.00 2.20 1.00" with Rare = 10 and
#                     Epic = 4 gives a level 55-60 player 22% blue and 4% epic per kill.
#                     Bloodforged items ignore Rate.Drop.Item.*. Items that always drop (rare mobs, Hidden
#                     Caches, Crow's Cache) are not changed. 0 = no such drops. Decimals allowed.
#        Default:     1

Bloodforged.DropRate.Rare = 1
Bloodforged.DropRate.Epic = 1

#    Bloodforged.MarksOfWar.NormalMob
#    Bloodforged.MarksOfWar.HighRiskElite
#    Bloodforged.MarksOfWar.RareMob
#    Bloodforged.MarksOfWar.RareEliteMob
#    Bloodforged.MarksOfWar.HiddenCache
#    Bloodforged.MarksOfWar.RareHiddenCache
#    Bloodforged.MarksOfWar.EpicHiddenCache
#        Description: Silver (1201002) and Golden (1201003) Marks of War that a High-Risk player gets from
#                     each source. Each value has four numbers:
#
#                         "<Silver always> <% chance for 1 more Silver> <Gold always> <% chance for 1 more Gold>"
#
#                     The "always" marks are given every time; then one roll decides the extra Silver
#                     and one roll the extra Gold. Examples:
#                         "0 1 0 0"    = 1% chance for 1 Silver, never Gold
#                         "1 10 0 10"  = always 1 Silver (10% chance for 2), 10% chance for 1 Gold
#                         "2 50 1 20"  = always 2 Silver (50% for 3), always 1 Gold (20% for 2)
#
#                     NormalMob is used by normal mobs and ordinary elites, HighRiskElite only by the
#                     entries in Bloodforged.HighRiskEliteEntries. The three HiddenCache keys are the
#                     green, rare and epic Hidden Caches. Crow's Cache marks are set with
#                     CrowsCache.SilverMarksOfWar and CrowsCache.GoldenMarksOfWar.
#                     Marks are not scaled by Rate.Drop.Item.*; use the DropRate keys below.
#        Default:     "0 5 0 0.5", "0 8 0 0.5", "1 10 0 10", "2 10 0 50", "1 10 0 0", "1 60 0 20", "2 50 1 20"

Bloodforged.MarksOfWar.NormalMob = "0 5 0 0.5"
Bloodforged.MarksOfWar.HighRiskElite = "0 8 0 0.5"
Bloodforged.MarksOfWar.RareMob = "1 10 0 10"
Bloodforged.MarksOfWar.RareEliteMob = "2 10 0 50"
Bloodforged.MarksOfWar.HiddenCache = "1 10 0 0"
Bloodforged.MarksOfWar.RareHiddenCache = "1 60 0 20"
Bloodforged.MarksOfWar.EpicHiddenCache = "2 50 1 20"

#    Bloodforged.DropRate.SilverMarkOfWar
#    Bloodforged.DropRate.GoldenMarkOfWar
#        Description: Turns all Marks of War chances above up or down at once. Only the "% chance"
#                     numbers are multiplied, never the "always" marks, and a chance never goes above 100%.
#                     Example: SilverMarkOfWar = 3 makes "0 1 0 0" a 3% Silver chance and "1 10 0 10"
#                     always 1 Silver with a 30% chance for 2. 0 = only the "always" marks drop.
#        Default:     1

Bloodforged.DropRate.SilverMarkOfWar = 1
Bloodforged.DropRate.GoldenMarkOfWar = 1

#    Bloodforged.BazaarTokens.HighRiskElite
#    Bloodforged.BazaarTokens.RareMob
#    Bloodforged.BazaarTokens.RareEliteMob
#        Description: Bazaar Tokens (975001) that every High-Risk player in the group gets for killing a
#                     High-Risk elite (Bloodforged.HighRiskEliteEntries), a rare or a rare elite in the open
#                     world, when the mob is not grey to them and they are close enough to share the loot.
#                     Counts against the hourly Bazaar Token limit (CoA.BazaarTokens.HourlyCap.Amount);
#                     tokens over the limit are not given. 0 = no tokens.
#        Default:     300, 300, 300

Bloodforged.BazaarTokens.HighRiskElite = 300
Bloodforged.BazaarTokens.RareMob = 300
Bloodforged.BazaarTokens.RareEliteMob = 300

#    Bloodforged.BazaarTokens.HiddenCache
#    Bloodforged.BazaarTokens.RareHiddenCache
#    Bloodforged.BazaarTokens.EpicHiddenCache
#        Description: Bazaar Tokens (975001) for the player who opens a green, rare or epic Hidden Cache.
#                     Counts against the hourly Bazaar Token limit; tokens over the limit are not given.
#                     0 = no tokens.
#        Default:     40, 100, 150

Bloodforged.BazaarTokens.HiddenCache = 40
Bloodforged.BazaarTokens.RareHiddenCache = 100
Bloodforged.BazaarTokens.EpicHiddenCache = 150

#
#    Ascension.PrestigiousCache.ReleaseStage
#        Description: The newest tier the realm has released, 1-6. A Prestigious Cache pays
#                     tokens of its own content only, and never one from a tier above this
#                     one, so a Classic-stage realm never hands out a Tier 6 token. Tier
#                     2.5 counts as 2.5, so 3 still covers it.
#        Default:     6

Ascension.PrestigiousCache.ReleaseStage = 6

#
#    Ascension.PrestigiousCache.TokenChancePercent
#        Description: Chance for a Prestigious Cache to also hand over one of its own tier's
#                     tokens, "a chance of one or more global tier tokens, if tiers are
#                     released" as the cache's own description puts it. A cache whose
#                     content has no token of its own pays none.
#        Default:     25

Ascension.PrestigiousCache.TokenChancePercent = 25

#
#    Ascension.PrestigiousCache.SecondTokenChancePercent
#        Description: Chance for that first token to be two.
#        Default:     5

Ascension.PrestigiousCache.SecondTokenChancePercent = 5

#
#    Ascension.PrestigiousCache.ClassicStages
#        Description: Additional Classic pool limit, 0-8. Pools must also be released by
#                     Ascension.CallboardCache.ReleaseStage. Existing tier caches obey both limits.
#                     Pool order: 1287304 onwards for Heroic Dungeons, Zul'Gurub, Molten Core,
#                     Onyxia, Blackwing Lair, Ruins of Ahn'Qiraj, Temple of Ahn'Qiraj,
#                     Naxxramas. The generic "most recent Prestigious Cache available"
#                     resolves to the newest allowed populated pool.
#        Default:     8

Ascension.PrestigiousCache.ClassicStages = 8

#
#    Ascension.PrestigiousCache.PreviousStageOnly
#        Description: Hold Classic Prestigious Caches and their tier tokens one release stage
#                     below Ascension.CallboardCache.ReleaseStage, so a raid's cache is paid
#                     only once the stage after it is released.
#        Default:     0

Ascension.PrestigiousCache.PreviousStageOnly = 0

#
#    Ascension.PrestigiousCache.TbcStages
#        Description: How many of the Burning Crusade Prestigious Caches are released, 0-9,
#                     in the order 1297310 held for Karazhan, Gruul's Lair, Magtheridon's
#                     Lair, Serpentshrine Caverns, Tempest Keep, Zul'Aman, The Battle for
#                     Mount Hyjal, Black Temple, Sunwell. Zero keeps the generic caches on
#                     the Classic ladder.
#        Default:     0

Ascension.PrestigiousCache.TbcStages = 0

#
#    Ascension.CallboardCache.ReleaseStage
#        Description: The realm's current content progression stage, 0-8. Every stage also
#                     releases the stages before it:
#                     0 - normal dungeons only
#                     1 - Heroic Dungeons
#                     2 - Mythic Dungeons
#                     3 - Zul'Gurub
#                     4 - Molten Core
#                     5 - Onyxia's Lair
#                     6 - Blackwing Lair
#                     7 - Ruins of Ahn'Qiraj and Temple of Ahn'Qiraj
#                     8 - Naxxramas
#                     A raid or dungeon difficulty above the stage is closed: entering it
#                     shows "Instance is closed" and a character logging in inside it is
#                     moved out. Game Masters still enter; other maps are not affected. The
#                     client lists Heroic and Mythic difficulties only once they are released.
#                     Callboard Caches follow the same stages: only released caches are
#                     earned, and a generic Callboard Cache resolves to a released tier.
#                     High-Risk content (Bloodforged raid gear, Crow's Cache) does not follow this
#                     value; it uses HighRisk.ReleaseStage.
#                     Applied on .reload config; the client's difficulty list on next login.
#                     .raidphase set <0-8> overrides this value in the characters database
#                     until .raidphase clear; .raidphase shows the stage.
#        Default:     3

Ascension.CallboardCache.ReleaseStage = 3

#
#    Ascension.CallboardCache.PreviousStageOnly
#        Description: Hold every generic Callboard Cache one stage below the released one.
#                     The 1378050 cache promises "gear up to the previous tier released"
#                     and stops there on its own whatever this is set to.
#        Default:     0

Ascension.CallboardCache.PreviousStageOnly = 0

#
#    Ascension.CallboardCache.ItemLevelAllowance
#        Description: How far above the opener's average equipped item level a Callboard
#                     Cache may reach: "This Callboard Cache gives you rewards based on
#                     your item level." Rewards are preferred at the opener's own level or
#                     above, never further up than this allowance.
#        Default:     6

Ascension.CallboardCache.ItemLevelAllowance = 6

#
#    Ascension.CallboardCache.CachePoints
#        Description: Callboard Cache progress points that pay one cache. Each Callboard
#                     quest adds its points from ascension_callboard_quest_points; a full
#                     bar pays the cache of the highest released ascension_callboard_cache_tier
#                     row at or below the character's highest average item level reached,
#                     and the remainder carries over. The client shows a tenth of every
#                     amount: a 150-point bar as 15, a 25-point quest as 3 (rounded up).
#        Default:     150

Ascension.CallboardCache.CachePoints = 150

#
#    Ascension.CallboardCache.GoldMin
#    Ascension.CallboardCache.GoldMax
#        Description: Gold paid on top of the item when a Callboard Cache opens, rolled
#                     between these two amounts. GoldMax 0 pays no gold.
#        Default:     5, 15

Ascension.CallboardCache.GoldMin = 5
Ascension.CallboardCache.GoldMax = 15

#
#    CoA.CallboardContracts.Enable
#        Description: Call Board Temporal Contracts. Every contract type listed in
#                     ascension_callboard_contract earns DailyCompletions completions per day
#                     begun since the weekly reset; missed days bank up until that reset. A
#                     character can take and turn in quests of a type only while it has
#                     completions left, and the Call Board's Complete Now button finishes the
#                     banked ones for gold or Bazaar Tokens.
#        Default:     1

CoA.CallboardContracts.Enable = 1

#
#    CoA.CallboardContracts.DailyCompletions
#        Description: Completions every contract type earns per day, shared by all its quests.
#        Default:     1

CoA.CallboardContracts.DailyCompletions = 1

#
#    CoA.CallboardContracts.MoneyCostMultiplier
#    CoA.CallboardContracts.MinMoneyCost
#        Description: Gold price of one Complete Now completion: the quest's money reward
#                     times the multiplier, at least MinMoneyCost copper.
#        Default:     2.0, 100000

CoA.CallboardContracts.MoneyCostMultiplier = 2.0
CoA.CallboardContracts.MinMoneyCost = 100000

#
#    CoA.CallboardContracts.TokenCostMultiplier
#    CoA.CallboardContracts.MinTokenCost
#        Description: Bazaar Token price of one Complete Now completion: the quest's Bazaar
#                     Token reward times the multiplier, at least MinTokenCost tokens.
#        Default:     2.0, 50

CoA.CallboardContracts.TokenCostMultiplier = 2.0
CoA.CallboardContracts.MinTokenCost = 50

#
#    CoA.DungeonTuning.Enable
#        Description: Allow `.mythic damage` and `.mythic health` in 5-man dungeons. Every player can
#                     raise or lower the damage and health of the creatures in their own instance
#                     by a percentage to try values; each change is logged as a TUNING line.
#                     For test realms; switch it off on a live realm.
#        Default:     1

CoA.DungeonTuning.Enable = 1

#
#    CoA.DungeonNormal.Enable
#        Description: Normal tuning of the Ascension boss kits in 5-man dungeons. The kit spells listed
#                     in coa_dungeon_normal_spell_damage deal Ascension's Normal rank damage (casters
#                     below level 50) or the Heroic damage / 1.66 * 0.85, without the dungeon creature
#                     damage scaling, and their repeat timers run longer.
#        Default:     1

CoA.DungeonNormal.Enable = 1

#
#    CoA.FierceBlow.Enable
#        Description: Ascension's Fierce Blow (975011) on every hostile creature fighting a player or a
#                     player's unit: one every 6-9.5 s, taking the place of its next melee swing. It
#                     cannot be dodged, parried or missed. Creatures that already schedule their own
#                     Fierce Blow (boss kits, SmartAI, C++ scripts) keep their own timing.
#        Default:     1

CoA.FierceBlow.Enable = 1

#
#    CoA.DungeonNormal.RepeatFactor
#        Description: How much longer a boss kit spell takes to come back on Normal (1.1 = 10% longer).
#        Default:     1.1

CoA.DungeonNormal.RepeatFactor = 1.1

#
#    CoA.DungeonNormal.AreaHitCapPct
#    CoA.DungeonNormal.TargetHitCapPct
#        Description: On Normal no single hit of a boss kit spell deals more than this share of the
#                     player's maximum health: area spells / single target spells. 0 turns a cap off.
#        Default:     25, 40

CoA.DungeonNormal.AreaHitCapPct = 25
CoA.DungeonNormal.TargetHitCapPct = 40

#
#    CoA.TestZoneBonus.AnnounceIntervalMinutes
#        Description: How often every player is told which test zones are active and what they earn
#                     there. The zones themselves live in coa_test_zone_bonus and are managed with
#                     .testzone; making a zone a test zone is always announced. 0 turns the reminder off.
#        Default:     15

CoA.TestZoneBonus.AnnounceIntervalMinutes = 15

#
#    CrowsCache.Enable
#        Description: The Crow's Cache High-Risk PvP event. A cache starts only from Mythic Dungeons
#                     (HighRisk.ReleaseStage 2) and only while at least three Heroic
#                     Bloodforged rewards are released, so it also needs Bloodforged.Enable = 1. Until
#                     then the automatic schedule skips its turns (unclaimed caches are still removed at
#                     each turn) and .crows start is refused.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

CrowsCache.Enable = 0
CrowsCache.IntervalSeconds = 10800
CrowsCache.WarningSeconds = 1800

#    CrowsCache.SilverMarksOfWar
#    CrowsCache.GoldenMarksOfWar
#        Description: How many Silver (1201002) and Golden (1201003) Marks of War an opened Crow's Cache
#                     gives, as "<lowest> <highest>". The amount is picked at random between the two
#                     numbers each time. Use the same number twice for a fixed amount, "0 0" for none.
#                     Highest allowed: 200. Not changed by any drop rate setting.
#        Default:     "5 10", "10 10"

CrowsCache.SilverMarksOfWar = "5 10"
CrowsCache.GoldenMarksOfWar = "10 10"

#    CrowsCache.BazaarTokens
#        Description: Bazaar Tokens (975001) for the player who opens a claimed Crow's Cache in town.
#                     Counts against the hourly Bazaar Token limit; tokens over the limit are not given.
#                     0 = no tokens.
#        Default:     400

CrowsCache.BazaarTokens = 400
