+    if not active() or not pending or prefix ~= "A52LIB" or channel ~= "WHISPER" or sender ~= UnitName("player") then return end
+    if text:match("^ERROR|([0-9a-f]+)|") == pending.token then
+        pending = nil
+        message("The shared library service is unavailable. Your local builds have not been changed by this request.")
+        return
+    end
+    local token, generation, state, added, updated, skipped = text:match("^UPDATE|([0-9a-f]+)|(%d+)|(%a+)|(%d+)|(%d+)|(%d+)$")
+    if not generation or token ~= pending.token then return end
+    if state == "queued" or state == "running" then
+        pending.generation = generation
+    elseif state == "complete" then
+        if pending.generation and pending.generation ~= generation then return end
+        pending = nil
+        BuildCreatorFrame.lastQueried = nil
+        message("Library updated: " .. added .. " new, " .. updated .. " updated, " .. skipped .. " incompatible. Reopen the build list to view shared copies.")
+    elseif state == "failed" then
