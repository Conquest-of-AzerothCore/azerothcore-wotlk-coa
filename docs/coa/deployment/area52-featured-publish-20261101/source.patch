+			text = TIP_RESTORE_WIP_BUILD,
+			textJustifyH = "CENTER",
+			targetPoint = HelpTip.Point.BottomEdgeCenter,
+			buttonStyle = HelpTip.ButtonStyle.GotIt,
+			highlightTarget = HelpTip.TargetType.Box,
