+function BuildCreatorMixin:OpenBuildEditor()
+	self:HideBuildList()
+	if not self.EditableBuildViewPanel:IsShown() then
+		self.EditableBuildViewPanel.deserializeNext = true
+		self.EditableBuildViewPanel:Show()
+	else
