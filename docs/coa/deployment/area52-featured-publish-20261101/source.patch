-local function integer(value, maximum)
-    assert(type(value) == "number" and value >= 0 and value <= maximum and value == math.floor(value), "Invalid number")
-    return value
-end
-
-local function text(value, maximum)
-    value = value or ""
-    assert(type(value) == "string" and #value <= maximum and not value:find("%z"), "Invalid text")
-    return value
-end
-
-local function array(value, maximum, convert)
-    assert(type(value) == "table" and #value <= maximum, "Invalid list")
-    local result, seen = {}, {}
-    for key in pairs(value) do assert(type(key) == "number" and key >= 1 and key <= #value and key == math.floor(key), "Invalid list index") end
-    for i, row in ipairs(value) do
-        result[i] = convert(row)
-        local id = result[i].Spell or result[i].Enchant or result[i].Type
-        assert(not seen[id], "Duplicate selection")
-        seen[id] = true
-    end
-    return result
-end
-
-function Import.Validate(build)
-    assert(type(build) == "table", "Invalid build")
-    local result = {}
-    for key, limit in pairs({Name=128, Icon=256, Description=8192}) do result[key] = text(build[key], limit) end
-    assert(#result.Name > 0, "Missing build name")
-    for _, key in ipairs({'Category','Roles','PrimaryStat','DifficultyRating'}) do result[key]=text(build[key],64) end
-    assert(Enum.BuildRoles[result.Roles] or result.Roles=='PLAYER_ROLE_NONE', 'Invalid role')
-    local stats={STAT_STRENGTH=true,STAT_AGILITY=true,STAT_INTELLECT=true,STAT_SPIRIT=true}
-    assert(stats[result.PrimaryStat], 'Invalid primary stat')
-    local validDifficulty=false
-    for _,value in pairs(Enum.BuildDifficulty) do if value==result.DifficultyRating then validDifficulty=true end end
-    assert(validDifficulty,'Invalid difficulty')
-    local validCategory = false
-    for _, key in ipairs({"Leveling", "Level60PvE", "Level60PvP", "Level70PvE", "Level70PvP", "BuildDraft", "BuildDraftEndGamePvE", "BuildDraftEndGamePvP"}) do
-        if Enum.BuildCategory[key] == result.Category then validCategory = true end
-    end
-    assert(validCategory, "Unsupported build category")
-    result.Spells = array(build.Spells, 512, function(row)
-        assert(type(row) == "table", "Invalid spell")
-        local r = {Spell=integer(row.Spell, 4294967295), Level=integer(row.Level or 1, 80), Comment=text(row.Comment,128), Flags=integer(row.Flags or 0,4294967295)}
-        assert(r.Spell > 0, "Invalid spell ID")
-        for _, key in ipairs({"IsCoreAbility", "IsOptimalAbility", "IsEmpoweringAbility", "IsSynergisticAbility"}) do
-            assert(row[key] == nil or type(row[key]) == "boolean", "Invalid spell role")
-            r[key] = row[key] or false
-        end
-        return r
-    end)
-    result.RandomEnchants = array(build.RandomEnchants, 64, function(row)
-        assert(type(row) == "table", "Invalid enchant")
-        local r = {Enchant=integer(row.Enchant,4294967295), Stacks=integer(row.Stacks,17), Level=integer(row.Level or 1,80), Comment=text(row.Comment,128), Flags=integer(row.Flags or 0,4294967295)}
-        assert(r.Enchant > 0 and r.Stacks > 0, "Invalid enchant selection")
-        return r
-    end)
-    for _, key in ipairs({"ArmorTypes", "WeaponTypes"}) do
-        result[key] = array(build[key],32,function(row)
-            assert(type(row) == "table", "Invalid equipment")
-            local kind=text(row.Type,64)
-            local allowed=key=='ArmorTypes' and Enum.ArmorSubClassSID or Enum.WeaponSubClassSID
-            assert(allowed[kind], 'Invalid equipment type')
-            return {Type=kind, Comment=text(row.Comment,128)}
-        end)
