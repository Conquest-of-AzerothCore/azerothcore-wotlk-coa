+function BuildCreatorMixin:ShowCreateCategories()
+	self.isCreateMode = true
+	self.categories = table.Copy(CreateCategories)
+	local showTip
+	if BuildCreatorSaved and next(BuildCreatorSaved.SavedBuilds) then
