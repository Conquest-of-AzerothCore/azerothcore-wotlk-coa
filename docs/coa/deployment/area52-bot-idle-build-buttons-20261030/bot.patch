+++ b/modules/mod-playerbots/src/Area52BotPresence.h
@@ -0,0 +1,57 @@
+#ifndef AREA52_BOT_PRESENCE_H
+#define AREA52_BOT_PRESENCE_H
+
+#include "Player.h"
+#include "PlayerbotAIConfig.h"
+#include "Playerbots.h"
+#include "WorldSession.h"
+#include "WorldSessionMgr.h"
+#include <chrono>
+
+inline bool Area52BotsShouldSleep()
+{
+    if (!sPlayerbotAIConfig.area52FixedPilot)
+        return false;
+
+    for (auto const& entry : sWorldSessionMgr->GetAllSessions())
+    {
+        WorldSession* session = entry.second;
+        Player* player = session ? session->GetPlayer() : nullptr;
+        if (player && player->IsInWorld() && !GET_PLAYERBOT_AI(player))
+            return false;
+    }
+    return true;
+}
+
+struct Area52BotIdleTimer
+{
+    bool hadPlayers = false;
+    bool waiting = false;
+    std::chrono::steady_clock::time_point emptySince;
+
+    bool LogoutDue(bool enabled, bool empty, std::chrono::steady_clock::time_point now)
+    {
+        if (!enabled)
+        {
+            hadPlayers = false;
+            waiting = false;
+            return false;
+        }
+        if (!empty)
+        {
+            hadPlayers = true;
+            waiting = false;
+            return false;
+        }
+        if (!hadPlayers)
+            return true;
+        if (!waiting)
+        {
+            emptySince = now;
+            waiting = true;
+        }
+        return now - emptySince >= std::chrono::seconds(300);
+    }
+};
+
+#endif
