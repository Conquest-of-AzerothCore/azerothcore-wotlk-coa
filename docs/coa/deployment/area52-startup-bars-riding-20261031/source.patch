+    static uint32 ResolveIncarnationDisplay(uint32 creatureId)
+    {
+        auto model = FindCollectionModel(creatureId);
+        return model && sCreatureDisplayInfoStore.LookupEntry(model->DisplayId) ? model->DisplayId : 0;
+    }
