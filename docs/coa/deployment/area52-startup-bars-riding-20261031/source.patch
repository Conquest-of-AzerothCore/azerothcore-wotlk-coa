+    }
+
+    void SnapshotDuration(SpellMissInfo missInfo)
+    {
+        _remaining = 0;
+        if (missInfo == SPELL_MISS_NONE)
+            if (Unit* target = GetHitUnit())
+                if (Aura* aura = target->GetAura(GetSpellInfo()->Id, GetCaster()->GetGUID()))
+                    _remaining = std::max(0, aura->GetDuration());
