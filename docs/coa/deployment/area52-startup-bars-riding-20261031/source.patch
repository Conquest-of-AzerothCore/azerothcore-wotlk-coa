-        return {};
-
-    uint32 const count = packet.read<uint32>(0);
-    if (!count || count > maxEntries ||
-        packet.size() != sizeof(uint32) + std::size_t(count) * sizeof(uint32))
-        return {};
-
-    std::vector<uint32> entries;
-    entries.reserve(count);
