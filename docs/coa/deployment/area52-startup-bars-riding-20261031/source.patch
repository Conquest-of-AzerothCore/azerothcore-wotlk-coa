-    {
-      std::lock_guard<std::mutex> lock(_stateLock);
-      _activeSpecializations[player->GetGUID().GetCounter()] = specializationId;
-    }
-    player->UpdatePlayerSetting(ASCENSION_ACTIVE_SPEC_SETTING, 0, specializationId);
