+  void QueueCharacterAdvancementState(Player* player)
+  {
+    std::lock_guard<std::mutex> lock(_stateLock);
+    _advancementPending.insert(player->GetGUID().GetCounter());
+    _advancementSent.erase(player->GetGUID().GetCounter());
+  }
