+F.PreviewLabels={"Combat pet / pet appearance reward","Incarnation preview (matches reward after launcher update)","Character cast visual","Pet cast visual","Bear incarnation reward","Cat incarnation reward","Tree incarnation reward","Metamorphosis incarnation reward"}
+F.RewardPets={
+    {id=1042,name="Red Whelp — combat pet"},
+    {id=24747,name="Fjord Hawk — combat pet"},
+    {id=35189,name="Skoll — combat pet"},
+    {id=6554,name="Gorishi Stinger — tameable combat pet"},
+    {id=74491,name="Vanguard Sentinel — Voidwalker appearance"},
+    {id=16941,name="Phasing Voidcaller — Voidwalker appearance"},
