-            LOG_ERROR("coa", "Area 52 verified Mystic Enchant access disabled: {}", error.what());
-        }
-    }
-    if (next != TestAccess)
-    {
-        TestAccess.swap(next);
-        LOG_INFO("coa", "Area 52 temporary verified Mystic Enchant access: {} entries", TestAccess.size());
-    }
-}
