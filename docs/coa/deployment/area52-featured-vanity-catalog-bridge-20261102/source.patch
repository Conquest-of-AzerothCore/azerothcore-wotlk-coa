+    for (uint16 opcode : { Area52Build::Create, Area52Build::Save, Area52Build::Delete, Area52Build::List, Area52Build::Get })
+        AscensionCompatOpcodes::Claim(opcode, &Queue);
+    new BuildWorld();
+    new BuildPlayer();
+    new LibraryRefreshPlayer();
+}
