-    if (spellId == SPELL_REALM_BANK)
-        return alliance ? BANK_OBJECT_REALM_ALLIANCE : BANK_OBJECT_REALM_HORDE;
-    if (spellId == SPELL_CELESTIAL_PERSONAL_BANK)
-        return BANK_OBJECT_CELESTIAL;
