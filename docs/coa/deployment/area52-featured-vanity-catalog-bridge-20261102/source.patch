+            presets << (stored && slot < stored->size() ? (*stored)[slot].value : std::uint32_t(0));
+    }
+    player->GetSession()->SendPacket(&presets);
+    WorldPacket active(0x600, 4);
+    active << ActivePreset(player);
+    player->GetSession()->SendPacket(&active);
