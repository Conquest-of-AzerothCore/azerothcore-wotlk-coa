-static bool IsAdventureModeTierAura(uint32 spellId)
-{
-    return spellId == 302053 || (spellId >= 302059 && spellId <= 302068 && (spellId - 302059) % 3 == 0) ||
-        (spellId >= 302600 && spellId <= 302882 && (spellId - 302600) % 3 == 0);
-}
