-  static time_t SameDayAt(time_t time, uint8 hour, uint8 minute) {
-    std::tm local = Acore::Time::TimeBreakdown(time);
-    local.tm_hour = hour;
-    local.tm_min = minute;
-    local.tm_sec = 0;
-    local.tm_isdst = -1;
-    return std::mktime(&local);
-  }
